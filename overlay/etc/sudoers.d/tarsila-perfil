# Nome de exibicao e foto do perfil, disparados pelo painel de Ajustes.
# O ajudante descobre a conta pelo SUDO_USER: nao da para apontar para
# outra conta, nem para o root.
tarsila ALL=(root) NOPASSWD: /usr/local/bin/tarsila-perfil nome *
tarsila ALL=(root) NOPASSWD: /usr/local/bin/tarsila-perfil foto
tarsila ALL=(root) NOPASSWD: /usr/local/bin/tarsila-perfil foto --remover
