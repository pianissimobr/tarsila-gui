#!/usr/bin/env python3
"""Avisa quando um dispositivo e conectado -- em duas etapas.

O usuario plugou uma webcam e nada na tela disse que algo tinha acontecido.
Ele precisava saber duas coisas em momentos diferentes: que a maquina PERCEBEU
o dispositivo, e depois que ele JA PODE ser usado. Sao dois instantes mesmo,
nao enfeite: entre encaixar o cabo e o driver terminar de preparar o aparelho
passam alguns segundos.

Por isso o aviso vem em duas etapas, e a segunda SUBSTITUI a primeira na tela
(mesmo replace-id do padrao de notificacoes):

  1. "Foi identificado um novo dispositivo conectado"   -- assim que a porta ve
  2. "<nome do aparelho>"                               -- quando ja da para usar
     "O seu dispositivo foi identificado e esta pronto para o uso"

A segunda etapa so aparece quando o subsistema especifico (video4linux, sound,
block...) confirma o aparelho. E o que torna a frase "pronto para o uso"
verdadeira em vez de otimista.

Roda dentro da sessao grafica, como o proprio usuario -- nao como regra de
udev com root. Assim ja tem o DBUS da sessao e nao precisa de permissao
nenhuma: "udevadm monitor" funciona para usuario comum.
"""

import atexit
import hashlib
import os
import subprocess
import sys
import threading
import time

# Quanto esperamos, depois do aviso 1, o subsistema que identifica o aparelho.
# Passado isto, avisamos assim mesmo com o simbolo generico de USB -- melhor um
# aviso menos preciso do que deixar a primeira mensagem orfa na tela.
ESPERA_IDENTIFICACAO = 6.0
# Eventos nos primeiros segundos sao do que ja estava plugado quando a sessao
# subiu. Avisar sobre eles seria mentira: ninguem conectou nada agora.
CARENCIA_INICIAL = 15.0
# Um mesmo aparelho reaparece varias vezes em segundos (uma vez por interface,
# e de novo se a porta for reautorizada). Dentro desta janela, avisa uma so vez.
JANELA_REPETICAO = 20.0

# Cada tipo com o seu simbolo do Papirus (todos conferidos como presentes).
# A entrada P2 (audio analogico) nao entra aqui de proposito: nao gera evento
# e o usuario disse que e instintiva.
TIPOS = {
    "webcam":    ("camera-web",                "Webcam"),
    "impressora": ("printer",                  "Impressora"),
    "microfone": ("audio-input-microphone",    "Microfone"),
    "midi":      ("audio-midi",                "Instrumento MIDI"),
    "pendrive":  ("drive-removable-media-usb", "Pendrive"),
    "disco":     ("drive-harddisk",            "HD externo"),
    "cartao":    ("media-flash",               "Cartão de memória"),
    "usb":       ("usb",                       "Dispositivo USB"),
}

# Um aparelho so costuma se apresentar por varios subsistemas: a webcam C925e
# tambem tem microfone, e o evento de som chega antes do de video. Quem ganha e
# quem esta mais acima nesta lista -- avisar "Microfone" quando a pessoa plugou
# uma webcam esta errado, ainda que nao seja mentira.
PRIORIDADE = ["webcam", "midi", "impressora", "cartao", "disco", "pendrive",
              "microfone"]


def avisar(titulo, corpo, icone, ident, tempo=6000):
    """Manda a notificacao. O mesmo 'ident' faz a segunda trocar a primeira."""
    cmd = ["notify-send", "-a", "Tarsila", "-r", str(ident),
           "-t", str(tempo), "-i", icone, titulo, corpo]
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def id_estavel(caminho):
    """Numero de 1 a 2^31 derivado do caminho: o mesmo aparelho, o mesmo id."""
    h = hashlib.md5(caminho.encode()).hexdigest()[:7]
    return int(h, 16) or 1


def raiz_do_aparelho(caminho):
    """O caminho do aparelho, sem a interface.

    /devices/.../usb1/1-2/1-2:1.0  ->  /devices/.../usb1/1-2
    As interfaces sempre trazem ":" no ultimo pedaco; o aparelho, nao."""
    pedacos = caminho.rstrip("/").split("/")
    if pedacos and ":" in pedacos[-1]:
        pedacos.pop()
    return "/".join(pedacos)


def nome_do_aparelho(prop, raiz=None):
    """O nome mais legivel que o udev souber dar.

    Se o evento veio de uma INTERFACE, ele nao traz o modelo -- quem tem essa
    informacao e o aparelho inteiro. Por isso, quando nao achamos nada aqui,
    perguntamos ao udev sobre a raiz antes de desistir."""
    def procurar(d):
        for chave in ("ID_MODEL_FROM_DATABASE", "ID_MODEL_ENC", "ID_MODEL",
                      "ID_NAME", "ID_SERIAL"):
            v = (d.get(chave) or "").strip()
            if v:
                v = v.replace("\\x20", " ").replace("_", " ").strip()
                if v:
                    return v
        return ""

    achado = procurar(prop)
    if not achado and raiz:
        try:
            saida = subprocess.run(
                ["udevadm", "info", "--query=property", "--path=" + raiz],
                capture_output=True, text=True, timeout=4).stdout
            d = dict(l.partition("=")[::2] for l in saida.splitlines() if "=" in l)
            achado = procurar(d)
        except Exception:
            pass
    return achado or "Dispositivo"


def classificar(sub, prop):
    """Descobre o tipo pelo subsistema que o kernel usou para o aparelho.

    Perguntar ao subsistema e mais confiavel do que adivinhar pela classe USB
    declarada: aparelhos baratos mentem na descricao, mas quem acaba
    carregando o driver nao mente."""
    # /devices/virtual e infraestrutura do kernel sem aparelho nenhum atras
    # -- zram, o sequenciador/timer do ALSA etc. Nunca e algo que alguem
    # plugou.
    if (prop.get("DEVPATH") or "").startswith("/devices/virtual/"):
        return None
    if sub == "video4linux":
        return "webcam"
    if sub == "sound":
        # SOUND_FORM_FACTOR=internal e o cartao de som embutido na placa --
        # toda TV box tem um. Sem este filtro, ele se anuncia como
        # "Microfone conectado" sem ninguem ter plugado nada (achado em
        # 23/08/2026, testando a versao deste classificador no menu de
        # dispositivos da barra).
        if prop.get("SOUND_FORM_FACTOR") == "internal":
            return None
        if "midi" in (prop.get("ID_ID", "") + prop.get("DEVPATH", "")).lower():
            return "midi"
        return "microfone"
    if sub in ("block", "mmc"):
        # MMC_TYPE=MMC e o eMMC interno (o disco de sistema) e MMC_TYPE=SDIO
        # e o Wi-Fi embutido nesta placa -- os dois usam o mesmo barramento
        # do cartao SD sem serem cartao nenhum. So MMC_TYPE=SD, exato, e
        # cartao removivel de verdade; "sub == 'mmc'" sozinho pegava os
        # tres juntos.
        if prop.get("MMC_TYPE") == "SD":
            return "cartao"
        if prop.get("ID_DRIVE_FLASH_SD"):
            return "cartao"
        if prop.get("ID_DRIVE_THUMB") or prop.get("ID_USB_DRIVER") == "usb-storage":
            # Disco grande com motor girando costuma se anunciar como rotacional
            rot = prop.get("ID_ATA_ROTATION_RATE_RPM")
            return "disco" if (rot and rot != "0") else "pendrive"
        # Sem nenhum sinal de USB/flash real (zram, o proprio eMMC, loop,
        # dm-*...) nao e um aparelho que alguem plugou.
        return None
    if sub == "usb":
        classe = prop.get("ID_USB_CLASS_FROM_DATABASE", "").lower()
        if "printer" in classe:
            return "impressora"
    return None


def _encerra_filho(p):
    """Mata o udevadm quando este programa sai, para nao deixar orfao."""
    if p.poll() is not None:
        return
    try:
        p.terminate()
        p.wait(timeout=3)
    except Exception:
        try:
            p.kill()
        except Exception:
            pass


def eventos():
    """Le o fluxo do udev e devolve um dicionario por evento.

    O "udevadm monitor" e um processo filho, e ate 24/08/2026 ele ficava orfao
    quando este daemon morria -- achei dois acumulados na box, um por reinicio.
    Em producao (sobe no login, morre no logout) so aparece um, entao nao era
    vazamento de verdade; ainda assim, filho que sobrevive ao pai e sujeira.
    O atexit cobre a saida normal e o SIGTERM; contra SIGKILL nao ha o que
    fazer -- ninguem consegue rodar codigo depois dele.
    """
    p = subprocess.Popen(
        ["udevadm", "monitor", "--udev", "--property",
         "--subsystem-match=usb", "--subsystem-match=video4linux",
         "--subsystem-match=sound", "--subsystem-match=block",
         "--subsystem-match=mmc"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1)
    atexit.register(_encerra_filho, p)
    prop, cab = {}, None
    for linha in p.stdout:
        linha = linha.rstrip("\n")
        if not linha:
            if cab and prop:
                yield cab, prop
            prop, cab = {}, None
            continue
        if linha.startswith("UDEV "):
            partes = linha.split()
            # UDEV [tempo] add /devices/... (subsistema)
            if len(partes) >= 5:
                cab = (partes[2], partes[3], partes[4].strip("()"))
            continue
        if "=" in linha and cab:
            k, _, v = linha.partition("=")
            prop[k] = v


def main():
    inicio = time.time()
    pendentes = {}          # raiz do aparelho -> (ident, nome, timer)
    avisados = {}           # raiz do aparelho -> quando avisamos por ultimo
    trava = threading.Lock()

    def concluir(raiz):
        """Fecha o aviso: escolhe o melhor tipo entre os que se apresentaram.

        Nao anunciamos no primeiro subsistema que aparece. A webcam solta o
        evento de som ANTES do de video, e avisar "Microfone" para quem plugou
        uma camera esta errado. Entao esperamos a poeira baixar e decidimos por
        prioridade."""
        with trava:
            dados = pendentes.pop(raiz, None)
        if not dados:
            return
        ident, nome, _, tipos = dados
        tipo = next((t for t in PRIORIDADE if t in tipos), "usb")
        icone, rotulo = TIPOS[tipo]
        if nome in ("Dispositivo", ""):
            nome = rotulo
        avisar(nome, "O seu dispositivo foi identificado e está pronto "
                     "para o uso", icone, ident)

    for (acao, caminho, sub), prop in eventos():
        if acao != "add" or time.time() - inicio < CARENCIA_INICIAL:
            continue

        # Etapa 1: a porta viu alguma coisa.
        # Nao basta esperar por DEVTYPE=usb_device. Um aparelho chega ao
        # sistema como VARIOS eventos -- a webcam solta quatro interfaces --, e
        # em algumas situacoes (reautorizacao da porta, religar o driver) so as
        # interfaces sao reemitidas, sem o evento do aparelho inteiro. Por isso
        # o gatilho e a RAIZ do aparelho: o caminho ate a porta, descartando o
        # sufixo ":1.0" da interface. Assim os quatro eventos da webcam viram
        # um aviso so, e funciona nos dois casos.
        if sub == "usb" and acao == "add":
            raiz = raiz_do_aparelho(caminho)
            with trava:
                repetido = raiz in pendentes or (
                    time.time() - avisados.get(raiz, 0) < JANELA_REPETICAO)
            if repetido:
                continue
            ident = id_estavel(raiz)
            nome = nome_do_aparelho(prop, raiz)
            avisar("Novo dispositivo",
                   "Foi identificado um novo dispositivo conectado",
                   TIPOS["usb"][0], ident, tempo=ESPERA_IDENTIFICACAO * 1000)
            t = threading.Timer(ESPERA_IDENTIFICACAO, concluir, args=(raiz,))
            t.daemon = True
            with trava:
                pendentes[raiz] = (ident, nome, t, set())
                avisados[raiz] = time.time()
            t.start()
            continue

        # Etapa 2: os drivers vao se apresentando. Aqui so ANOTAMOS o que
        # apareceu; quem anuncia e o concluir(), quando o tempo fecha.
        tipo = classificar(sub, prop)
        if not tipo:
            continue
        devpath = prop.get("DEVPATH", caminho)
        with trava:
            pai = next((c for c in pendentes if devpath.startswith(c)), None)
            if pai:
                pendentes[pai][3].add(tipo)
                continue
        # Cartao de memoria entra pelo leitor interno, sem passar pelo USB:
        # nao houve etapa 1, entao fazemos as duas aqui.
        if tipo != "cartao":
            continue
        raiz = raiz_do_aparelho(devpath)
        with trava:
            if time.time() - avisados.get(raiz, 0) < JANELA_REPETICAO:
                continue
            avisados[raiz] = time.time()
        ident = id_estavel(raiz)
        nome = nome_do_aparelho(prop, raiz)
        avisar("Novo dispositivo",
               "Foi identificado um novo dispositivo conectado",
               TIPOS["usb"][0], ident, tempo=2500)
        time.sleep(2.5)
        icone, rotulo = TIPOS[tipo]
        avisar(nome if nome != "Dispositivo" else rotulo,
               "O seu dispositivo foi identificado e está pronto para o uso",
               icone, ident)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
