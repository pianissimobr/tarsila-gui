#!/bin/bash
# Move e redimensiona a janela dos Ajustes no olho, para acertar o encaixe.
#
# Uso:
#   tarsila-ajusta-janela            mostra onde ela esta e onde estao as bordas
#   tarsila-ajusta-janela +5         desce 5 px      (-5 sobe)
#   tarsila-ajusta-janela alt +10    aumenta 10 px de altura (-10 diminui)
#   tarsila-ajusta-janela encaixa    tenta encostar na barra de cima
export DISPLAY=${DISPLAY:-:0} XAUTHORITY=${XAUTHORITY:-$HOME/.Xauthority}
W=$(xdotool search --onlyvisible --name "^Ajustes$" | head -1)
[ -n "$W" ] || { echo "A janela Ajustes nao esta aberta."; exit 1; }
eval "$(xdotool getwindowgeometry --shell "$W")"
# A moldura vem do _NET_FRAME_EXTENTS (esquerda, direita, topo, base): e o
# unico lugar que diz quanto o gerenciador desenha em volta do conteudo.
EXT=$(xprop -id "$W" _NET_FRAME_EXTENTS | grep -oE "[0-9]+, [0-9]+, [0-9]+, [0-9]+")
MT=$(echo "$EXT" | awk -F", " "{print \$3}"); MB=$(echo "$EXT" | awk -F", " "{print \$4}")
: "${MT:=0}"; : "${MB:=0}"
QY=$((Y - MT)); QH=$((HEIGHT + MT + MB))
# O teto util era o fim da barra de cima. Sem barra, e o topo da tela: a
# janela maximizada vai ate y=0 e leva a propria barra de titulo junto.
FIM_BARRA=0
DOCK=$(for w in $(xdotool search --class plank); do
         eval "$(xdotool getwindowgeometry --shell "$w")"
         [ "${WIDTH:-0}" -gt 1000 ] && echo "$Y"; done | head -1)

case "${1:-}" in
  "")      echo "  janela : conteudo y=$Y altura=$HEIGHT"
           echo "  moldura: de $QY ate $((QY+QH))"
           echo "  topo da tela em $FIM_BARRA | Dock comeca em $DOCK"
           echo "  vao livre: $((DOCK - FIM_BARRA)) px" ;;
  alt)     xdotool windowsize "$W" "$WIDTH" $((HEIGHT + ${2:-0}))
           echo "  altura -> $((HEIGHT + ${2:-0}))" ;;
  encaixa) # Insiste ate acertar: o gerenciador soma a moldura ao que se pede,
           # entao uma passada so erra pela espessura dela.
           for _ in 1 2 3; do
               eval "$(xdotool getwindowgeometry --shell "$W")"
               EXT=$(xprop -id "$W" _NET_FRAME_EXTENTS | grep -oE "[0-9]+, [0-9]+, [0-9]+, [0-9]+")
               MT=$(echo "$EXT" | awk -F", " "{print \$3}"); : "${MT:=0}"
               SOBRA=$(( (Y - MT) - FIM_BARRA ))
               [ "${SOBRA#-}" -le 1 ] && break
               xdotool windowmove "$W" "$X" $((Y - SOBRA))
               sleep 0.3
           done
           echo "  topo da moldura encostado em $FIM_BARRA (topo da tela)" ;;
  *)       xdotool windowmove "$W" "$X" $((Y + $1))
           echo "  movida $1 px" ;;
esac
