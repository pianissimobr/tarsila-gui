#!/usr/bin/env python3
# Tarsila Redes — o usuário clica e escolhe a rede social; ao escolher,
# abre no navegador otimizado (ver tarsila-rede-abrir). Chooser GTK3 leve.
import subprocess
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk

REDES = [
    ('facebook',  'Facebook',    'facebook'),
    ('instagram', 'Instagram',   'instagram'),
    ('x',         'X (Twitter)', 'twitter'),
    ('whatsapp',  'WhatsApp',    'whatsapp'),
]


class Redes(Gtk.Window):
    def __init__(self):
        super().__init__(title='Redes')
        self.set_default_size(480, 280)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)
        try:
            self.set_wmclass('tarsila-redes', 'Tarsila-redes')
        except Exception:
            pass
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        v.set_border_width(18)
        self.add(v)
        t = Gtk.Label()
        t.set_markup('<big><b>Qual rede você quer abrir?</b></big>')
        v.pack_start(t, False, False, 0)
        grid = Gtk.Grid(column_spacing=16, row_spacing=14, column_homogeneous=True)
        grid.set_halign(Gtk.Align.CENTER)
        for i, (key, label, icon) in enumerate(REDES):
            b = Gtk.Button()
            b.set_relief(Gtk.ReliefStyle.NONE)
            bb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG)
            img.set_pixel_size(64)
            bb.pack_start(img, False, False, 0)
            bb.pack_start(Gtk.Label(label=label), False, False, 0)
            b.add(bb)
            b.connect('clicked', self.abrir, key)
            grid.attach(b, i % 2, i // 2, 1, 1)
        v.pack_start(grid, True, True, 0)
        self.show_all()

    def abrir(self, _b, key):
        try:
            subprocess.Popen(['tarsila-rede-abrir', key])
        except Exception as e:
            print('tarsila-redes:', e)
        Gtk.main_quit()


if __name__ == '__main__':
    w = Redes()
    w.connect('destroy', Gtk.main_quit)
    Gtk.main()
