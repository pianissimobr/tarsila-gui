#!/usr/bin/env python3
"""Diz onde uma janela deve nascer para ficar encostada na Dock.

As telas do Tarsila que saem da Dock -- Aplicativos Instalados, Lixeira,
Ajustes -- abrem todas do mesmo jeito: borda direita no fim da Dock e pe
encostado nela, como um menu que sai do proprio icone. Este utilitario existe
para esse calculo ficar num lugar so, em vez de copiado em cada programa.

Nada aqui e coordenada fixa: a Dock e medida agora. Se ela andar, as janelas
acompanham.

A janela da Dock ocupa a largura inteira da tela e pinta so o pedaco do meio,
entao a geometria dela nao responde "onde termina a Dock?". Quem sabe e a
propria Dock, que publica o retangulo pintado em
$XDG_RUNTIME_DIR/tarsila-dock-geom ("x y larg alt") a cada reposicionamento.

COMO ERA ATE 17/08/2026, e por que mudou

Este arquivo procurava a janela pela classe "plank" e, quando achava, tirava
uma CAPTURA DE TELA dela (`import -window`) e varria os pixels com PIL para
achar onde a pintura terminava. Duas coisas estavam erradas:

  1. o Plank saiu em 16/08. A busca voltava vazia, esta funcao devolvia None
     SEMPRE, e quem chama -- a Lixeira e os menus da barra -- caia no plano B,
     abrindo no lugar aproximado. O trabalho caro nunca chegava a rodar; o
     barato, achar a janela, era o que falhava;
  2. mesmo funcionando, fotografar a tela e comparar pixel a pixel para
     descobrir um numero que outro processo ja tem na memoria e caro neste
     aparelho -- e ainda arrastava PIL e ImageMagick para o caminho de abrir
     uma janela.

Uso:  tarsila-pos-dock <largura> <altura> [toolkit]
      toolkit: "gtk" (padrao) ou "yad" -- muda so a compensacao da moldura.
Saida: "X Y" ja compensado, pronto para move()/--geometry.
"""

import os
import subprocess
import sys

GEOM = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                    "tarsila-dock-geom")

# Quanto o pe da janela desce DENTRO da Dock. Era 29 ate 17/08/2026, e nao por
# estetica: o Y vinha do topo da janela do Plank, que era mais alta que o
# desenho e tinha uma faixa transparente em cima. Os 29 px cancelavam essa
# faixa, e a janela encostava na pintura sem cobrir icone nenhum.
#
# Agora o Y publicado pela Dock JA E o topo do que esta pintado, entao descer
# qualquer coisa seria cobrir os icones. Compensacao de moldura continua sendo
# feita, essa sim, logo abaixo.
DESCE_ATE = 0

# O gerenciador acrescenta a decoracao ao que se pede, e o quanto depende de
# quem pede. Medido nesta box, e nao e o mesmo numero para todos:
#   gtk      Gtk.Window comum, movida antes de show()      -> 8 / 39
#   gtk-app  Gtk.ApplicationWindow exibida via present()   -> 8 / 30
#   yad      via --geometry                                -> 9 / 66
# Descontamos aqui para a janela nascer no lugar em vez de ser corrigida
# depois -- e a correcao depois e justamente o "pulinho" que se via ao abrir.
COMPENSA = {"gtk": (8, 39), "gtk-app": (8, 30), "yad": (9, 66)}


def dock():
    """(x do fim da Dock, y do topo da Dock) ou None se ela nao estiver de pe.

    O arquivo pode estar velho: ele sobrevive ao processo que o escreveu. Por
    isso confirmamos que a janela existe antes de acreditar nele -- uma chamada
    ao xdotool, contra a captura de tela inteira que havia aqui antes.
    """
    try:
        with open(GEOM) as f:
            x, y, larg, _alt = (int(v) for v in f.read().split()[:4])
    except (OSError, ValueError):
        return None
    try:
        vivo = subprocess.run(["xdotool", "search", "--class", "tarsila-dock"],
                              capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return None
    if not vivo:
        return None
    return x + larg, y


def main():
    if len(sys.argv) < 3:
        sys.exit("uso: tarsila-pos-dock <largura> <altura> [gtk|yad]")
    larg, alt = int(sys.argv[1]), int(sys.argv[2])
    kit = sys.argv[3] if len(sys.argv) > 3 else "gtk"
    cx, cy = COMPENSA.get(kit, COMPENSA["gtk"])
    d = dock()
    if not d:
        sys.exit(1)               # sem Dock visivel: quem chamou que centralize
    direita, topo = d
    print("%d %d" % (direita - larg - cx, topo - alt + DESCE_ATE - cy))


if __name__ == "__main__":
    main()
