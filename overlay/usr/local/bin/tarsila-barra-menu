#!/usr/bin/env python3
"""Menus suspensos dos indicadores: som, rede, calendario e sistema.

Quem chama e a tarsila-barra, no alto da tela, passando --abaixo-de. Entre
15/08 e 17/08/2026 quem chamava eram seis icones na Dock, no intervalo em que
nao havia barra nenhuma -- por isso o fallback ainda ancora acima da Dock.

Antes, clicar no alto-falante abria o Controle de Volume inteiro, e clicar na
rede abria o editor de conexoes -- duas janelas grandes para uma pergunta
pequena ("esta alto demais?", "em que rede eu estou?"). Aqui a resposta vem
num quadrinho abaixo do icone, e a janela grande fica a um clique de distancia
para quem realmente precisar dela.

Fecha ao perder o foco ou com Esc, como todo menu.

Uso:  tarsila-barra-menu som
      tarsila-barra-menu rede
      tarsila-barra-menu calendario
      tarsila-barra-menu sistema
"""

import os
import re
import subprocess
import sys
import time

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

SINK = "@DEFAULT_AUDIO_SINK@"

# Cores do diagnostico. Tons escuros de proposito: o fundo do menu e claro,
# e verde/amarelo vivos ficam ilegiveis nele.
VERDE    = "#1e8e3e"
AMARELO  = "#b06000"
VERMELHO = "#c5221f"


# ------------------------------------------------------- diagnostico rapido
# Tudo aqui e FOTO do instante: le /proc uma vez (duas no caso da CPU, que so
# existe como diferenca entre dois momentos) e pronto. Nada fica rodando --
# quem abre o menu paga o custo, e ele morre junto com a janela.

def uso_cpu(intervalo=0.25):
    """Porcentagem de uso da CPU agora.

    /proc/stat guarda tempo ACUMULADO desde o boot, entao um numero sozinho
    nao diz nada: a leitura tem de ser a diferenca entre dois instantes. Um
    quarto de segundo e curto para o usuario e longo o bastante para nao dar
    um valor ao acaso.
    """
    def ler():
        with open("/proc/stat", encoding="utf-8") as f:
            campos = f.readline().split()[1:9]
        v = [int(x) for x in campos]
        return sum(v), v[3] + v[4]      # (total, ocioso = idle + iowait)

    try:
        total1, ocioso1 = ler()
        time.sleep(intervalo)
        total2, ocioso2 = ler()
    except (OSError, ValueError, IndexError):
        return None
    dt = total2 - total1
    if dt <= 0:
        return None
    ocupado = dt - (ocioso2 - ocioso1)
    return max(0, min(100, round(100 * ocupado / dt)))


def uso_memoria():
    """(bytes usados, bytes totais). MemAvailable e o que o kernel considera
    realmente disponivel -- cache reaproveitavel nao conta como usado."""
    info = {}
    try:
        with open("/proc/meminfo", encoding="utf-8") as f:
            for linha in f:
                chave, _, valor = linha.partition(":")
                info[chave] = int(valor.split()[0]) * 1024
    except (OSError, ValueError, IndexError):
        return None, None
    total = info.get("MemTotal")
    livre = info.get("MemAvailable", info.get("MemFree"))
    if not total or livre is None:
        return None, None
    return total - livre, total


def uso_disco(caminho="/"):
    """(bytes usados, bytes totais) da raiz, pelo espaco visivel ao usuario."""
    try:
        st = os.statvfs(caminho)
    except OSError:
        return None, None
    total = st.f_blocks * st.f_frsize
    livre = st.f_bavail * st.f_frsize      # f_bavail: sem o reservado do root
    if total <= 0:
        return None, None
    return total - livre, total


def tamanho_legivel(n):
    """1,4 GB / 512 MB -- virgula decimal, como se escreve em portugues."""
    if n is None:
        return "?"
    if n >= 1024 ** 3:
        return ("%.1f GB" % (n / 1024 ** 3)).replace(".", ",")
    return "%d MB" % round(n / 1024 ** 2)


def veredito(pct, limites, palavras):
    """(texto, cor) a partir da porcentagem. limites = (ok, atencao)."""
    if pct is None:
        return "sem leitura", AMARELO
    ok, atencao = limites
    if pct < ok:
        return palavras[0], VERDE
    if pct < atencao:
        return palavras[1], AMARELO
    return palavras[2], VERMELHO


def roda(*args, tempo=6):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=tempo)
        return r.returncode == 0, r.stdout.strip()
    except Exception:
        return False, ""


# ---------------------------------------------------------------- som
def volume_atual():
    """(porcentagem, mudo).

    Mesma cadeia que a barra usa: wpctl primeiro, pactl se ele nao responder.
    Sem o plano B, o menu mostrava 0% enquanto a barra mostrava o som ligado --
    dois numeros diferentes para a mesma coisa."""
    ok, saida = roda("wpctl", "get-volume", SINK)
    if ok and "Volume:" in saida:
        try:
            pct = int(round(float(saida.split()[1]) * 100))
        except (IndexError, ValueError):
            pct = 0
        return pct, "MUTED" in saida.upper()

    ok, saida = roda("pactl", "get-sink-volume", "@DEFAULT_SINK@")
    pct = 0
    if ok:
        achado = re.search(r"(\d+)%", saida)
        if achado:
            pct = int(achado.group(1))
    ok2, mudo = roda("pactl", "get-sink-mute", "@DEFAULT_SINK@")
    return pct, bool(ok2 and "yes" in mudo.lower())


def aplica_volume(pct):
    # O teto de 100% evita distorcao: o PipeWire aceita passar disso, e o som
    # satura sem o usuario entender por que "aumentar" piorou.
    pct = max(0, min(100, int(pct)))
    if not roda("wpctl", "set-volume", SINK, "%d%%" % pct)[0]:
        roda("pactl", "set-sink-volume", "@DEFAULT_SINK@", "%d%%" % pct)
    return pct


def corta_som(ligar_mudo):
    if not roda("wpctl", "set-mute", SINK, "1" if ligar_mudo else "0")[0]:
        roda("pactl", "set-sink-mute", "@DEFAULT_SINK@",
             "1" if ligar_mudo else "0")


# --------------------------------------------------------------- rede
def estado_da_rede():
    """(titulo, nome da rede, endereco IP) da conexao em uso."""
    ok, saida = roda("nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION",
                     "device", "status")
    if not ok:
        return "Sem conexão", "", ""
    escolhido = None
    for linha in saida.splitlines():
        p = linha.split(":")
        if len(p) >= 4 and p[2] == "connected" and p[1] in ("ethernet", "wifi"):
            # Cabo ganha do Wi-Fi quando os dois estao ligados, que e por onde
            # a maquina realmente sai.
            if p[1] == "ethernet":
                escolhido = p
                break
            escolhido = escolhido or p
    if not escolhido:
        return "Sem conexão", "", ""
    titulo = ("Conexão por cabo" if escolhido[1] == "ethernet"
              else "Conexão Wi-Fi")
    ok, ip = roda("nmcli", "-g", "IP4.ADDRESS", "device", "show", escolhido[0])
    ip = ip.splitlines()[0].split("/")[0].strip() if ok and ip.strip() else ""
    return titulo, escolhido[3], ip


# ---------------------------------------------------- dispositivos plugados
# Mesma classificacao do tarsila-dispositivos (o daemon que avisa quando algo
# e conectado): aqui e so uma foto do que o udev ja sabe agora, lendo o banco
# inteiro de uma vez em vez de escutar o fluxo de eventos.
TIPOS_DISPOSITIVO = {
    "webcam":     ("camera-web",                "Webcam"),
    "impressora": ("printer",                   "Impressora"),
    "microfone":  ("audio-input-microphone",    "Microfone"),
    "midi":       ("audio-midi",                "Instrumento MIDI"),
    "pendrive":   ("drive-removable-media-usb", "Pendrive"),
    "disco":      ("drive-harddisk",            "HD externo"),
    "cartao":     ("media-flash",               "Cartão de memória"),
    "usb":        ("usb",                       "Dispositivo USB"),
}


def _classificar_dispositivo(sub, prop):
    # /devices/virtual e infraestrutura do kernel sem aparelho nenhum atras
    # -- zram, o sequenciador/timer do ALSA etc. Nunca e algo que alguem
    # plugou.
    if (prop.get("DEVPATH") or "").startswith("/devices/virtual/"):
        return None
    if sub == "video4linux":
        return "webcam"
    if sub == "sound":
        # SOUND_FORM_FACTOR=internal e o cartao de som embutido na placa --
        # toda TV box tem um, e sem este filtro ele aparecia na lista como
        # "Microfone" mesmo sem nenhum microfone plugado (achado em
        # 23/08/2026, junto com o mesmo problema no eMMC abaixo).
        if prop.get("SOUND_FORM_FACTOR") == "internal":
            return None
        if "midi" in (prop.get("ID_ID", "") + prop.get("DEVPATH", "")).lower():
            return "midi"
        return "microfone"
    if sub in ("block", "mmc"):
        # MMC_TYPE=MMC e o eMMC interno (o disco de sistema) e MMC_TYPE=SDIO
        # e o Wi-Fi embutido nesta placa -- os dois usam o mesmo barramento
        # do cartao SD sem serem cartao nenhum. So MMC_TYPE=SD, exato, e
        # cartao removivel de verdade; "sub == 'mmc'" sozinho pegava os
        # tres juntos (o disco de sistema E o Wi-Fi apareciam como "Cartão
        # de memória" em toda TV box).
        if prop.get("MMC_TYPE") == "SD":
            return "cartao"
        if prop.get("ID_DRIVE_FLASH_SD"):
            return "cartao"
        if prop.get("ID_DRIVE_THUMB") or prop.get("ID_USB_DRIVER") == "usb-storage":
            rot = prop.get("ID_ATA_ROTATION_RATE_RPM")
            return "disco" if (rot and rot != "0") else "pendrive"
        # Sem nenhum sinal de USB/flash real (zram, o proprio eMMC, loop,
        # dm-*...) nao e um aparelho que alguem plugou -- era daqui que
        # vinha o "Pendrive" fantasma (o zram, RAM comprimida de swap).
        return None
    if sub == "usb":
        classe = prop.get("ID_USB_CLASS_FROM_DATABASE", "").lower()
        if "printer" in classe:
            return "impressora"
    return None


def _raiz_do_aparelho(caminho):
    pedacos = caminho.rstrip("/").split("/")
    if pedacos and ":" in pedacos[-1]:
        pedacos.pop()
        return "/".join(pedacos)
    # Placa de som: controlC0, pcmC0D0p etc. são sub-nós do MESMO cartão
    # (.../sound/card0/pcmC0D0p) -- corta em "cardN", senão cada um vira um
    # "aparelho" à parte e nenhum carrega o SOUND_FORM_FACTOR do pai.
    for i, p in enumerate(pedacos):
        if re.fullmatch(r"card\d+", p):
            return "/".join(pedacos[:i + 1])
    return "/".join(pedacos)


def _nome_do_aparelho(prop):
    for chave in ("ID_MODEL_FROM_DATABASE", "ID_MODEL_ENC", "ID_MODEL",
                  "ID_NAME", "ID_SERIAL"):
        v = (prop.get(chave) or "").strip()
        if v:
            v = v.replace("\\x20", " ").replace("_", " ").strip()
            if v:
                return v
    return ""


def dispositivos_conectados():
    """[(ícone, nome p/ mostrar)] dos aparelhos plugáveis ligados agora,
    numa ordem estável (a de TIPOS_DISPOSITIVO) e sem repetir o mesmo
    aparelho físico (a mesma raiz de dispositivo aparece uma vez por
    interface -- usb, som, bloco --, aqui conta só uma)."""
    try:
        saida = subprocess.run(
            ["udevadm", "info", "--export-db"],
            capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return []

    # Um aparelho físico pode aparecer em vários blocos "P:" (uma placa de
    # som tem um para o cartão e um para cada pcm/control dela). Primeiro
    # junta TODAS as propriedades de cada raiz -- só depois classifica --
    # senão um bloco filho sem SOUND_FORM_FACTOR próprio (só o cartão pai
    # tem) passava pelo filtro do embutido.
    por_raiz = {}   # raiz -> (subsistema, propriedades combinadas)
    caminho, sub, prop = None, None, {}

    def fecha():
        if not (caminho and sub):
            return
        raiz = _raiz_do_aparelho(caminho)
        sub_atual, props_atual = por_raiz.get(raiz, (None, {}))
        props_atual = dict(props_atual)
        props_atual.update(prop)
        por_raiz[raiz] = (sub_atual or sub, props_atual)

    for linha in saida.splitlines():
        if linha.startswith("P: "):
            fecha()
            caminho, sub, prop = linha[3:], None, {}
        elif linha.startswith("E: SUBSYSTEM="):
            sub = linha.split("=", 1)[1]
        elif linha.startswith("E: "):
            k, _, v = linha[3:].partition("=")
            prop[k] = v
    fecha()

    por_tipo = {}
    for sub, prop in por_raiz.values():
        tipo = _classificar_dispositivo(sub, prop)
        if tipo:
            por_tipo.setdefault(tipo, set()).add(_nome_do_aparelho(prop))

    resultado = []
    for tipo in TIPOS_DISPOSITIVO:
        icone, rotulo = TIPOS_DISPOSITIVO[tipo]
        for nome in sorted(por_tipo.get(tipo, ())):
            resultado.append((icone, nome or rotulo))
    return resultado


# -------------------------------------------------------------- janela
class Popup(Gtk.Window):
    def __init__(self, modo):
        # TOPLEVEL, nao POPUP: janela POPUP nao recebe foco, e entao o
        # "perdeu o foco" que fecha o menu disparava no instante em que ele
        # abria. Com TOPLEVEL sem decoracao temos a mesma aparencia e o
        # comportamento certo.
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_resizable(False)
        self.set_border_width(0)

        moldura = Gtk.Frame()
        moldura.set_shadow_type(Gtk.ShadowType.OUT)
        self.add(moldura)
        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        caixa.set_margin_start(14)
        caixa.set_margin_end(14)
        caixa.set_margin_top(12)
        caixa.set_margin_bottom(10)
        moldura.add(caixa)

        if modo == "som":
            self._monta_som(caixa)
        elif modo == "calendario":
            self._monta_calendario(caixa)
        elif modo == "sistema":
            self._monta_sistema(caixa)
        elif modo == "dispositivos":
            self._monta_dispositivos(caixa)
        else:
            self._monta_rede(caixa)

        # Fecha ao clicar FORA. So o "perdeu o foco" nao bastava: no Openbox
        # um clique na area de trabalho ou numa janela que nao aceita foco nao
        # tira o foco daqui, e o menu ficava aberto. Com o ponteiro agarrado,
        # todo clique passa por nos e sabemos se caiu dentro ou fora.
        self.connect("focus-out-event", lambda *_: Gtk.main_quit())
        self.connect("button-press-event", self._clique)
        self.connect("map-event", self._agarrar_ponteiro)
        self.connect("key-press-event", self._tecla)

    def _agarrar_ponteiro(self, *_a):
        janela = self.get_window()
        if janela is None:
            return False
        semente = Gdk.Display.get_default().get_default_seat()
        # owner_events=False: com True, um clique sobre uma janela que ja
        # seleciona evento de botao -- como os icones da barra, que tem
        # BUTTON_PRESS_MASK -- vai direto pro dono normal (a barra) em vez
        # de passar pelo grab. Descoberto em 23/08/2026: o clique num icone
        # com o popup aberto abria o novo por conta propria e so fechava o
        # antigo de carona (perda de foco), sem passar pelo _fecha_e_repassa
        # -- funcionava por acidente na maioria das vezes, nao sempre. Com
        # False, o clique SEMPRE chega aqui primeiro, sem excecao.
        semente.grab(janela, Gdk.SeatCapabilities.ALL_POINTING, False,
                     None, None, None, None)
        return False

    def _clique(self, _w, ev):
        largura, altura = self.get_size()
        # Coordenadas relativas a esta janela: fora dela, fecha.
        if not (0 <= ev.x <= largura and 0 <= ev.y <= altura):
            self._fecha_e_repassa(ev)
        return False

    def _fecha_e_repassa(self, ev):
        """Fecha e refaz o clique no que estava por baixo -- outro icone da
        barra, a Dock, a area de trabalho.

        O ponteiro agarrado (_agarrar_ponteiro) manda TODO clique pra cá
        primeiro, mesmo o que caiu fora: sem isso o menu nao saberia que
        devia fechar (janelas que nao aceitam foco, como a barra e a area
        de trabalho, nao disparam "perdeu o foco"). Ate 23/08/2026 o clique
        de fora so fechava o menu e morria aqui -- pra ativar o que estava
        por baixo, a pessoa precisava clicar de novo. Largando o grab e
        repetindo o mesmo clique (mesma posicao, mesmo botao) depois de
        fechar, o segundo clique deixa de ser necessario."""
        x_root, y_root, botao = int(ev.x_root), int(ev.y_root), ev.button
        Gdk.Display.get_default().get_default_seat().ungrab()
        self.destroy()
        display = Gdk.Display.get_default()
        # sync() espera o X confirmar que o ungrab e o destroy ja foram
        # processados, nao so enviados -- flush() sozinho nao garante isso, e
        # nesta caixa (ARM lento) o xdotool podia chegar primeiro e clicar
        # ainda com o grab de pé, sem efeito nenhum.
        if hasattr(display, "sync"):
            display.sync()
        else:
            display.flush()
        # SEM --sync: essa flag do "mousemove" trava esperando uma
        # confirmacao de posicao que, depois de muito grab/ungrab em
        # sequencia, deixa de chegar -- o processo fica pendurado pra
        # sempre e o clique nunca sai. Sem ela, o mousemove e imediato.
        subprocess.Popen(
            ["xdotool", "mousemove", str(x_root), str(y_root),
             "click", str(botao)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True)
        Gtk.main_quit()

    @staticmethod
    def _tecla(_w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()
        return False

    def _rodape(self, caixa, rotulo, comando):
        """Link discreto, alinhado a direita, para a janela completa."""
        linha = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        linha.set_halign(Gtk.Align.END)
        btn = Gtk.Button(label=rotulo)
        btn.set_relief(Gtk.ReliefStyle.NONE)
        btn.connect("clicked", lambda *_: (
            subprocess.Popen(comando, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True),
            Gtk.main_quit()))
        linha.pack_start(btn, False, False, 0)
        caixa.pack_start(linha, False, False, 0)

    # ---- som
    def _monta_som(self, caixa):
        """Barra deslizante em vez de + e -.

        Apertar um botao varias vezes para chegar no volume desejado e o tipo
        de coisa que cansa: sao cinco toques para andar 25%. Arrastar mostra
        onde se esta e chega em qualquer ponto de uma vez -- e e o gesto que a
        pessoa ja conhece da TV e do celular."""
        pct, mudo = volume_atual()

        self.lbl = Gtk.Label()
        self._mostra(pct, mudo)
        caixa.pack_start(self.lbl, False, False, 0)

        linha = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.mudo_btn = Gtk.Button()
        self.mudo_btn.set_relief(Gtk.ReliefStyle.NONE)
        self._icone_mudo(mudo)
        self.mudo_btn.set_size_request(44, 44)
        self.mudo_btn.connect("clicked", lambda *_: self._corta())
        linha.pack_start(self.mudo_btn, False, False, 0)

        self.escala = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.escala.set_draw_value(False)
        self.escala.set_size_request(210, 44)
        self.escala.set_value(pct)
        # Marcas discretas: dao referencia de onde esta o meio e o topo.
        for ponto in (0, 50, 100):
            self.escala.add_mark(ponto, Gtk.PositionType.BOTTOM, None)
        self._mudando = False
        self.escala.connect("value-changed", self._arrastou)
        linha.pack_start(self.escala, True, True, 0)
        caixa.pack_start(linha, False, False, 0)

        self._rodape(caixa, "Mixer de áudio", ["pavucontrol"])

    def _icone_mudo(self, mudo):
        nome = "audio-volume-muted" if mudo else "audio-speakers"
        img = Gtk.Image.new_from_icon_name(nome, Gtk.IconSize.LARGE_TOOLBAR)
        self.mudo_btn.set_image(img)
        self.mudo_btn.set_tooltip_text("Ligar o som" if mudo else "Cortar o som")

    def _mostra(self, pct, mudo):
        self.lbl.set_markup(
            "<b>Som desligado</b>" if mudo else "<b>Volume %d%%</b>" % pct)

    def _arrastou(self, escala):
        if self._mudando:
            return
        novo = int(escala.get_value())
        aplica_volume(novo)
        # Mexer no volume tira do mudo: e o que a pessoa espera ao arrastar.
        corta_som(False)
        self._mostra(novo, False)
        self._icone_mudo(False)

    def _corta(self):
        _, mudo = volume_atual()
        corta_som(not mudo)
        pct, agora = volume_atual()
        self._mostra(pct, agora)
        self._icone_mudo(agora)

    # ---- calendário
    def _monta_calendario(self, caixa):
        """Só o calendário do mês, sem nada em volta.

        Quem clica no relógio quer ver "que dia é hoje" ou "em que dia da
        semana cai o dia 20". Um seletor de mês e ano já bastaria confundir,
        então ficam só as setas do próprio calendário."""
        cal = Gtk.Calendar()
        cal.set_display_options(Gtk.CalendarDisplayOptions.SHOW_HEADING
                                | Gtk.CalendarDisplayOptions.SHOW_DAY_NAMES)
        # Clicar num dia não faz nada -- não há para onde ir. Mas o duplo
        # clique voltaria para o mês de hoje, que é útil depois de navegar.
        cal.connect("day-selected-double-click", lambda *_: self._hoje(cal))
        caixa.pack_start(cal, False, False, 0)

    @staticmethod
    def _hoje(cal):
        agora = GLib.DateTime.new_now_local()
        cal.select_month(agora.get_month() - 1, agora.get_year())
        cal.select_day(agora.get_day_of_month())

    # ---- rede
    # ---- diagnostico rapido do sistema
    def _monta_sistema(self, caixa):
        """Foto do sistema agora: processador, memoria e armazenamento.

        Uma linha por item: nome, quanto esta em uso e um veredito curto em
        verde/amarelo/vermelho -- para quem nao sabe o que e "78% de 2 GB"
        saber, mesmo assim, se esta bem ou apertado.
        """
        titulo = Gtk.Label(xalign=0)
        titulo.set_markup("<b>Como está o sistema</b>")
        caixa.pack_start(titulo, False, False, 0)

        cpu = uso_cpu()
        mem_uso, mem_total = uso_memoria()
        dis_uso, dis_total = uso_disco()

        mem_pct = round(100 * mem_uso / mem_total) if mem_total else None
        dis_pct = round(100 * dis_uso / dis_total) if dis_total else None

        linhas = (
            ("Processador",
             "%d%%" % cpu if cpu is not None else "?",
             veredito(cpu, (50, 80),
                      ("tranquilo", "trabalhando", "sobrecarregado"))),
            ("Memória",
             "%s de %s" % (tamanho_legivel(mem_uso), tamanho_legivel(mem_total)),
             veredito(mem_pct, (70, 88),
                      ("tranquila", "um pouco cheia", "quase no limite"))),
            ("Armazenamento",
             "%s de %s" % (tamanho_legivel(dis_uso), tamanho_legivel(dis_total)),
             veredito(dis_pct, (75, 90),
                      ("bastante espaço", "enchendo", "quase sem espaço"))),
        )

        # Grade para as tres colunas ficarem alinhadas entre si.
        grade = Gtk.Grid()
        grade.set_column_spacing(12)
        grade.set_row_spacing(4)
        grade.set_margin_top(6)
        for i, (nome, valor, (parecer, cor)) in enumerate(linhas):
            rot = Gtk.Label(xalign=0)
            rot.set_markup('<small><span alpha="70%%">%s</span></small>'
                           % GLib.markup_escape_text(nome))
            val = Gtk.Label(xalign=0)
            val.set_markup("<small>%s</small>" % GLib.markup_escape_text(valor))
            par = Gtk.Label(xalign=0)
            par.set_markup('<small><span foreground="%s"><b>%s</b></span></small>'
                           % (cor, GLib.markup_escape_text(parecer)))
            grade.attach(rot, 0, i, 1, 1)
            grade.attach(val, 1, i, 1, 1)
            grade.attach(par, 2, i, 1, 1)
        caixa.pack_start(grade, False, False, 0)

        # Deixa claro que e uma foto, nao um medidor que fica correndo.
        nota = Gtk.Label(xalign=0)
        nota.set_markup('<small><span alpha="55%%">Medido agora, ao abrir.'
                        '</span></small>')
        nota.set_margin_top(8)
        caixa.pack_start(nota, False, False, 0)

    # ---- dispositivos
    def _monta_dispositivos(self, caixa):
        """Lista os aparelhos plugáveis conectados agora (webcam, impressora,
        pendrive etc.) -- foto do udev ao abrir, igual ao "sistema"."""
        titulo = Gtk.Label(xalign=0)
        titulo.set_markup("<b>Dispositivos conectados</b>")
        caixa.pack_start(titulo, False, False, 0)

        aparelhos = dispositivos_conectados()
        if not aparelhos:
            vazio = Gtk.Label(xalign=0)
            vazio.set_markup('<small><span alpha="70%">Nenhum dispositivo '
                             'disponível</span></small>')
            vazio.set_margin_top(6)
            caixa.pack_start(vazio, False, False, 0)
            return

        grade = Gtk.Grid()
        grade.set_column_spacing(10)
        grade.set_row_spacing(6)
        grade.set_margin_top(6)
        for i, (icone, nome) in enumerate(aparelhos):
            img = Gtk.Image.new_from_icon_name(icone, Gtk.IconSize.LARGE_TOOLBAR)
            rot = Gtk.Label(xalign=0, label=nome)
            grade.attach(img, 0, i, 1, 1)
            grade.attach(rot, 1, i, 1, 1)
        caixa.pack_start(grade, False, False, 0)

    def _monta_rede(self, caixa):
        titulo, nome, ip = estado_da_rede()
        t = Gtk.Label(xalign=0)
        t.set_markup("<b>%s</b>" % GLib.markup_escape_text(titulo))
        caixa.pack_start(t, False, False, 0)
        for rotulo, valor in (("Rede", nome), ("Endereço IP", ip)):
            if not valor:
                continue
            linha = Gtk.Label(xalign=0)
            linha.set_markup(
                '<small><span alpha="70%%">%s</span>  %s</small>'
                % (GLib.markup_escape_text(rotulo),
                   GLib.markup_escape_text(valor)))
            caixa.pack_start(linha, False, False, 0)
        self._rodape(caixa, "Ver conexões", ["nm-connection-editor"])


def topo_da_dock(altura_janela):
    """Y onde o menu deve comecar para ficar encostado por CIMA da Dock.

    O calculo por pixel mora no tarsila-pos-dock e e o mesmo que a Lixeira e
    a tela "Aplicativos Instalados" usam: o Plank ocupa a largura toda da
    tela mas so pinta o pedaco do meio, entao nao da para usar a geometria
    da janela dele -- tem de olhar ate onde ela esta pintada.

    Nao chamamos o pos-dock aqui porque ele devolve X e Y de um canto, e o X
    dele encosta o menu no fim da Dock. Estes menus saem de um icone
    especifico e seguem o ponteiro na horizontal; so o Y interessa.
    """
    ok, saida = roda("xdotool", "search", "--class", "tarsila-dock")
    if ok:
        for w in saida.split():
            _, geo = roda("xdotool", "getwindowgeometry", "--shell", w)
            d = dict(l.split("=", 1) for l in geo.splitlines() if "=" in l)
            # A Dock em GTK e larga mas nao ocupa a tela toda (ela tem folga
            # lateral), entao o criterio antigo de ">1000" nao serve como
            # esta: usamos "mais da metade da tela".
            if int(d.get("WIDTH", 0)) > 400:
                topo = int(d.get("Y", 0))
                if topo > 0:
                    return topo - altura_janela - 2
    return None


def main():
    modo = sys.argv[1] if len(sys.argv) > 1 else "som"
    janela = Popup(modo)
    janela.show_all()

    # Sai de CIMA do icone que foi clicado na Dock, como um menu que brota
    # dele. Ate 2026-08-15 estes menus desciam da barra de cima; ela nao
    # existe mais e o clique agora vem de baixo.
    tela = janela.get_screen()
    largura_tela = tela.get_width()
    altura_tela = tela.get_height()
    largura, altura = janela.get_size()
    ponteiro = tela.get_display().get_default_seat().get_pointer()
    _, x, _ = ponteiro.get_position()[:3]

    # Quem chamou pode dizer de onde veio. A barra de indicadores fica no TOPO
    # da tela: um menu que brota dela tem de descer, nao aparecer no rodape a
    # 700px de distancia do icone clicado.
    #   tarsila-barra-menu som --abaixo-de 24
    abaixo = None
    if "--abaixo-de" in sys.argv:
        try:
            abaixo = int(sys.argv[sys.argv.index("--abaixo-de") + 1])
        except (IndexError, ValueError):
            abaixo = None

    if abaixo is not None:
        y = max(0, abaixo + 2)
    else:
        y = topo_da_dock(altura)
        if y is None or y < 0:
            # Dock escondida, ainda subindo, ou medida sem sentido: encosta no
            # rodape da tela em vez de deixar o menu no canto superior esquerdo.
            y = max(4, altura_tela - altura - 4)

    x = max(4, min(x - largura // 2, largura_tela - largura - 4))
    janela.move(x, y)
    janela.present()
    janela.grab_focus()
    Gtk.main()


if __name__ == "__main__":
    main()
