#!/usr/bin/env python3
# Tarsila Notícias — leitor de RSS/Atom minimal, SEM web engine (o Liferea
# embutia WebKit = 119MB). Aqui: lista de manchetes (feedparser) e ao clicar
# abre a matéria no navegador do sistema. Feeds em
# ~/.config/tarsila/noticias-feeds.json.
import os, json, threading, subprocess, datetime, time
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib, Gdk

CFG_DIR = os.path.expanduser('~/.config/tarsila')
CFG = os.path.join(CFG_DIR, 'noticias-feeds.json')
MAX_ITENS = 120
DEFAULTS = [
    {'name': 'G1', 'url': 'https://g1.globo.com/rss/g1/'},
    {'name': 'BBC Brasil', 'url': 'https://feeds.bbci.co.uk/portuguese/rss.xml'},
]


def load_feeds():
    try:
        with open(CFG) as f:
            return json.load(f)
    except Exception:
        return list(DEFAULTS)


def save_feeds(f):
    os.makedirs(CFG_DIR, exist_ok=True)
    with open(CFG, 'w') as fp:
        json.dump(f, fp, indent=2, ensure_ascii=False)


def fetch_all(feeds):
    import feedparser
    itens, errs = [], []
    for src in feeds:
        try:
            d = feedparser.parse(src['url'])
            nm = src.get('name') or (d.feed.get('title', src['url']) if d.feed else src['url'])
            for e in d.entries[:40]:
                ts = None
                for k in ('published_parsed', 'updated_parsed'):
                    if e.get(k):
                        ts = time.mktime(e[k]); break
                itens.append({'title': e.get('title', '(sem título)').strip(),
                              'link': e.get('link', ''), 'src': nm, 'ts': ts or 0})
        except Exception as ex:
            errs.append('%s: %s' % (src.get('name') or 'feed', ex))
    itens.sort(key=lambda x: x['ts'], reverse=True)
    return itens[:MAX_ITENS], errs


def abrir(link):
    if link:
        subprocess.Popen(['xdg-open', link], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


class Noticias(Gtk.Window):
    def __init__(self):
        super().__init__(title='Notícias')
        self.set_default_size(760, 640)
        try:
            self.set_wmclass('tarsila-noticias', 'Tarsila-noticias')
        except Exception:
            pass
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(box)
        tb = Gtk.Box(spacing=6); tb.set_border_width(8)
        t = Gtk.Label(); t.set_markup('<b>Notícias</b>'); t.set_xalign(0)
        tb.pack_start(t, True, True, 0)
        b_ref = Gtk.Button.new_from_icon_name('view-refresh', Gtk.IconSize.BUTTON)
        b_ref.set_tooltip_text('Atualizar'); b_ref.connect('clicked', lambda *_: self.reload())
        tb.pack_start(b_ref, False, False, 0)
        b_cfg = Gtk.Button.new_with_label('Fontes'); b_cfg.connect('clicked', self.on_config)
        tb.pack_start(b_cfg, False, False, 0)
        box.pack_start(tb, False, False, 0)
        box.pack_start(Gtk.Separator(), False, False, 0)
        self.status = Gtk.Label(); self.status.set_xalign(0)
        self.status.set_margin_start(12); self.status.set_margin_top(6)
        box.pack_start(self.status, False, False, 0)
        sc = Gtk.ScrolledWindow(); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.listbox = Gtk.ListBox(); self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.listbox.connect('row-activated', self.on_row)
        sc.add(self.listbox)
        box.pack_start(sc, True, True, 0)
        self.show_all()
        self.reload()

    def reload(self):
        for r in self.listbox.get_children():
            self.listbox.remove(r)
        self.status.set_markup('<i>Buscando notícias…</i>')
        threading.Thread(target=self._bg, args=(load_feeds(),), daemon=True).start()

    def _bg(self, feeds):
        itens, errs = fetch_all(feeds)
        GLib.idle_add(self._render, itens, errs)

    def _render(self, itens, errs):
        if errs and not itens:
            self.status.set_markup('<span foreground="#b04a3a">Sem internet ou fontes inválidas.</span>')
        else:
            self.status.set_text('')
        for it in itens:
            row = Gtk.ListBoxRow(); row.link = it['link']
            b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            b.set_margin_top(6); b.set_margin_bottom(6); b.set_margin_start(12); b.set_margin_end(12)
            tl = Gtk.Label(); tl.set_markup('<b>%s</b>' % GLib.markup_escape_text(it['title']))
            tl.set_xalign(0); tl.set_line_wrap(True)
            b.pack_start(tl, False, False, 0)
            sub = it['src']
            if it['ts']:
                sub += '  ·  ' + datetime.datetime.fromtimestamp(it['ts']).strftime('%d/%m %H:%M')
            sl = Gtk.Label(); sl.set_markup('<span foreground="#888" size="small">%s</span>'
                                            % GLib.markup_escape_text(sub))
            sl.set_xalign(0)
            b.pack_start(sl, False, False, 0)
            row.add(b)
            self.listbox.add(row)
        self.listbox.show_all()
        return False

    def on_row(self, _lb, row):
        abrir(getattr(row, 'link', ''))

    def on_config(self, *_):
        dlg = Gtk.Dialog(title='Fontes de notícias', transient_for=self, modal=True)
        dlg.add_button('Fechar', Gtk.ResponseType.CLOSE); dlg.set_default_size(560, 400)
        ca = dlg.get_content_area(); ca.set_border_width(12); ca.set_spacing(8)
        lst = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)

        def refresh_list():
            for c in lst.get_children():
                lst.remove(c)
            for idx, s in enumerate(load_feeds()):
                r = Gtk.Box(spacing=8)
                nm = Gtk.Label(label='• ' + (s.get('name') or s.get('url'))); nm.set_xalign(0)
                r.pack_start(nm, True, True, 0)
                rm = Gtk.Button.new_from_icon_name('user-trash', Gtk.IconSize.BUTTON)
                def _del(_b, i=idx):
                    ss = load_feeds(); del ss[i]; save_feeds(ss); refresh_list()
                rm.connect('clicked', _del)
                r.pack_start(rm, False, False, 0)
                lst.pack_start(r, False, False, 0)
            lst.show_all()

        ca.pack_start(Gtk.Label(label='Fontes atuais:', xalign=0), False, False, 0)
        ca.pack_start(lst, False, False, 0)
        ca.pack_start(Gtk.Separator(), False, False, 6)
        grid = Gtk.Grid(row_spacing=6, column_spacing=8)
        e_name = Gtk.Entry(); e_name.set_placeholder_text('Nome (ex: G1)')
        e_url = Gtk.Entry(); e_url.set_placeholder_text('Endereço do feed RSS/Atom')
        for i, (lab, w) in enumerate([('Nome', e_name), ('Feed', e_url)]):
            grid.attach(Gtk.Label(label=lab, xalign=1), 0, i, 1, 1)
            w.set_hexpand(True); grid.attach(w, 1, i, 1, 1)
        ca.pack_start(grid, False, False, 0)
        add = Gtk.Button.new_with_label('Adicionar fonte')

        def _add(*_):
            u = e_url.get_text().strip()
            if not u:
                return
            ss = load_feeds(); ss.append({'name': e_name.get_text().strip() or u, 'url': u})
            save_feeds(ss); e_name.set_text(''); e_url.set_text(''); refresh_list()
        add.connect('clicked', _add)
        ca.pack_start(add, False, False, 0)
        refresh_list(); dlg.show_all(); dlg.run(); dlg.destroy(); self.reload()


if __name__ == '__main__':
    w = Noticias(); w.connect('destroy', Gtk.main_quit); Gtk.main()
