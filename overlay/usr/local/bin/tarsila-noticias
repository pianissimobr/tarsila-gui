# RSS Guard Clone — executa com o Python do ambiente virtual
if [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    echo 'Erro: nenhuma sessão gráfica detectada (DISPLAY/WAYLAND_DISPLAY vazios).' >&2
    echo 'Rode no desktop, ou via SSH com: ssh -X usuario@host rssguard-clone' >&2
    exit 1
fi
exec /opt/rssguard-clone/venv/bin/python3 /opt/rssguard-clone/rssguard-clone.py "$@"
