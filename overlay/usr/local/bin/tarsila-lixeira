#!/usr/bin/env python3
"""Lixeira do Tarsila.

Por que nao e o Thunar: a Lixeira era "thunar trash:///", e esconder o menu, a
barra de endereco e a lateral so e possivel pelas preferencias do Thunar --
que sao globais. Testado na box: ao esconder, o aplicativo "Arquivos" perdeu a
lateral junto. E nao adianta copiar o executavel para ter um "Thunar 2": essas
preferencias nao moram no programa, moram num deposito por usuario (xfconf)
identificado pelo nome do canal, que e compilado dentro do Thunar -- duas
copias leriam o mesmo canal.

Entao aqui esta a mesma tela, sem o que sobra: lista com as colunas, e embaixo
os dois botoes. Tambem sai mais barato que abrir um gerenciador de arquivos
inteiro so para ver o que foi apagado.

Segue a norma freedesktop da lixeira:
    ~/.local/share/Trash/files/<nome>          o arquivo em si
    ~/.local/share/Trash/info/<nome>.trashinfo de onde veio e quando foi
Restaurar devolve o arquivo exatamente para a pasta de origem registrada ali.
"""

import os
import shutil
import subprocess
import sys
import tempfile
import urllib.parse
from datetime import datetime

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, GObject, Gio, Pango

LIXO = os.path.join(GLib.get_user_data_dir(), "Trash")
ARQUIVOS = os.path.join(LIXO, "files")
INFOS = os.path.join(LIXO, "info")

COL_ICONE, COL_NOME, COL_TAM, COL_DATA, COL_ORIGEM, COL_ARQ, COL_BYTES = range(7)

# Quanto o pe da janela desce dentro da faixa do Plank -- ali ainda e area
# transparente acima dos icones, entao ela encosta sem cobrir nada. Mesmo valor
# usado na tela "Aplicativos Instalados", derivado medindo a posicao que o
# usuario escolheu na mao.
DESCE_ATE = 29
LARGURA, ALTURA = 700, 460
# O gerenciador acrescenta a decoracao ao que se pede, entao descontamos aqui
# para a janela nascer no ponto certo em vez de ser corrigida depois. O valor
# vertical NAO e o mesmo da tela "Aplicativos Instalados" (que pede via yad):
# medido, o GTK soma 39 onde o yad soma 64. Por isso as duas janelas terminavam
# em linhas diferentes -- 693 contra 718 -- e o usuario notou.
# Nao sao coordenadas de tela: e a espessura da moldura, propriedade do tema.
COMPENSA_X, COMPENSA_Y = 8, 39


def tamanho_legivel(n):
    if n < 1024:
        return "%d B" % n
    for unidade in ("KiB", "MiB", "GiB"):
        n /= 1024.0
        if n < 1024 or unidade == "GiB":
            # A virgula troca o ponto no RESULTADO. Trocar no formato quebraria
            # o proprio "%.1f".
            return ("%.1f %s" % (n, unidade)).replace(".", ",")
    return "%.1f GiB" % n


def tamanho_de(caminho):
    """Tamanho do item; pastas somam o conteudo."""
    if os.path.islink(caminho):
        return 0
    if os.path.isfile(caminho):
        try:
            return os.path.getsize(caminho)
        except OSError:
            return 0
    total = 0
    for raiz, _, nomes in os.walk(caminho):
        for n in nomes:
            try:
                total += os.path.getsize(os.path.join(raiz, n))
            except OSError:
                pass
    return total


def ler_info(nome):
    """Le o .trashinfo: devolve (caminho de origem, data de exclusao)."""
    arq = os.path.join(INFOS, nome + ".trashinfo")
    origem, data = "", None
    try:
        with open(arq, encoding="utf-8") as f:
            for linha in f:
                linha = linha.strip()
                if linha.startswith("Path="):
                    origem = urllib.parse.unquote(linha[5:])
                elif linha.startswith("DeletionDate="):
                    try:
                        data = datetime.strptime(linha[13:], "%Y-%m-%dT%H:%M:%S")
                    except ValueError:
                        data = None
    except OSError:
        pass
    if origem and not origem.startswith("/"):
        origem = os.path.join(GLib.get_home_dir(), origem)
    return origem, data


def data_legivel(d):
    if not d:
        return ""
    hoje = datetime.now().date()
    if d.date() == hoje:
        return "Hoje, %s" % d.strftime("%H:%M")
    if (hoje - d.date()).days == 1:
        return "Ontem, %s" % d.strftime("%H:%M")
    return d.strftime("%d/%m/%Y %H:%M")


def caminho_livre(destino):
    """Se ja existir arquivo com esse nome no destino, acrescenta (2), (3)..."""
    if not os.path.exists(destino):
        return destino
    base, ext = os.path.splitext(destino)
    i = 2
    while os.path.exists("%s (%d)%s" % (base, i, ext)):
        i += 1
    return "%s (%d)%s" % (base, i, ext)


class Lixeira(Gtk.Window):
    def __init__(self):
        super().__init__(title="Lixeira")
        # Sem redimensionar e sem botao de maximizar, como a tela
        # "Aplicativos Instalados" e a Calculadora. Num programa nosso isso e
        # direto: set_resizable(False) marca minimo = maximo nas dicas de
        # tamanho, e o Openbox, vendo isso, esconde o botao e recusa o arrasto
        # das bordas. MOVER continua funcionando pela barra de titulo.
        # Como janela nao-redimensionavel ignora set_default_size (ela assume o
        # tamanho natural do conteudo), o tamanho vem de um pedido na lista.
        self.set_resizable(False)
        self.set_icon_name("user-trash")

        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(caixa)

        self.loja = Gtk.ListStore(str, str, str, str, str, str,
                                  GObject.TYPE_INT64)
        self.lista = Gtk.TreeView(model=self.loja)
        self.lista.set_rubber_banding(True)
        self.lista.get_selection().set_mode(Gtk.SelectionMode.MULTIPLE)
        self.lista.connect("row-activated", lambda *a: self.restaurar())

        # Nome, com o icone do tipo de arquivo ao lado -- como no gerenciador.
        col = Gtk.TreeViewColumn("Nome")
        ic = Gtk.CellRendererPixbuf()
        col.pack_start(ic, False)
        col.add_attribute(ic, "icon-name", COL_ICONE)
        txt = Gtk.CellRendererText()
        txt.set_property("ellipsize", Pango.EllipsizeMode.MIDDLE)
        col.pack_start(txt, True)
        col.add_attribute(txt, "text", COL_NOME)
        col.set_sort_column_id(COL_NOME)
        col.set_resizable(True)
        col.set_expand(True)
        self.lista.append_column(col)

        for titulo, coluna, ordena, alinha in (
                ("Tamanho", COL_TAM, COL_BYTES, 1.0),
                ("Data de exclusão", COL_DATA, COL_DATA, 0.0),
                ("Caminho do arquivo", COL_ORIGEM, COL_ORIGEM, 0.0)):
            r = Gtk.CellRendererText()
            r.set_property("xalign", alinha)
            if coluna == COL_ORIGEM:
                r.set_property("ellipsize", Pango.EllipsizeMode.MIDDLE)
            c = Gtk.TreeViewColumn(titulo, r, text=coluna)
            c.set_sort_column_id(ordena)
            c.set_resizable(True)
            if coluna == COL_ORIGEM:
                c.set_expand(True)
            self.lista.append_column(c)

        rolagem = Gtk.ScrolledWindow()
        rolagem.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        rolagem.set_shadow_type(Gtk.ShadowType.IN)
        rolagem.add(self.lista)
        rolagem.set_margin_start(6)
        rolagem.set_margin_end(6)
        rolagem.set_margin_top(6)
        rolagem.set_size_request(LARGURA - 12, ALTURA - 104)
        caixa.pack_start(rolagem, True, True, 0)

        botoes = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        botoes.set_halign(Gtk.Align.CENTER)
        botoes.set_margin_top(8)
        botoes.set_margin_bottom(8)
        self.b_restaurar = Gtk.Button(label="Restaurar itens selecionados")
        self.b_restaurar.connect("clicked", lambda *a: self.restaurar())
        self.b_esvaziar = Gtk.Button(label="Esvaziar Lixeira")
        self.b_esvaziar.connect("clicked", lambda *a: self.esvaziar())
        botoes.pack_start(self.b_restaurar, False, False, 0)
        botoes.pack_start(self.b_esvaziar, False, False, 0)
        caixa.pack_start(botoes, False, False, 0)

        self.rodape = Gtk.Label(xalign=0.0)
        self.rodape.set_margin_start(8)
        self.rodape.set_margin_bottom(4)
        caixa.pack_start(self.rodape, False, False, 0)

        self.recarregar()
        # Se algo mexer na lixeira por fora (o usuario apagando um arquivo no
        # gerenciador), a lista se atualiza sozinha.
        try:
            self.vigia = Gio.File.new_for_path(ARQUIVOS).monitor_directory(
                Gio.FileMonitorFlags.NONE, None)
            self.vigia.connect("changed", lambda *a: self.recarregar())
        except GLib.Error:
            self.vigia = None

    def recarregar(self):
        self.loja.clear()
        total = 0
        try:
            nomes = sorted(os.listdir(ARQUIVOS))
        except OSError:
            nomes = []
        for nome in nomes:
            caminho = os.path.join(ARQUIVOS, nome)
            origem, data = ler_info(nome)
            bytes_ = tamanho_de(caminho)
            total += bytes_
            icone = "folder" if os.path.isdir(caminho) else "text-x-generic"
            gio_f = Gio.File.new_for_path(caminho)
            try:
                info = gio_f.query_info("standard::icon", 0, None)
                nomes_icone = info.get_icon().get_names()
                if nomes_icone:
                    icone = nomes_icone[0]
            except GLib.Error:
                pass
            self.loja.append([icone, nome, tamanho_legivel(bytes_),
                              data_legivel(data),
                              os.path.dirname(origem) or "", caminho, bytes_])
        n = len(self.loja)
        self.rodape.set_text(
            "Lixeira vazia" if not n else
            "%d %s: %s" % (n, "arquivo" if n == 1 else "arquivos",
                           tamanho_legivel(total)))
        self.b_restaurar.set_sensitive(n > 0)
        self.b_esvaziar.set_sensitive(n > 0)

    def selecionados(self):
        modelo, caminhos = self.lista.get_selection().get_selected_rows()
        return [modelo[c][COL_NOME] for c in caminhos]

    def aviso(self, texto, detalhe=""):
        d = Gtk.MessageDialog(transient_for=self, modal=True,
                              message_type=Gtk.MessageType.WARNING,
                              buttons=Gtk.ButtonsType.OK, text=texto)
        if detalhe:
            d.format_secondary_text(detalhe)
        d.run()
        d.destroy()

    def restaurar(self):
        nomes = self.selecionados()
        if not nomes:
            self.aviso("Escolha o que restaurar",
                       "Toque em um ou mais itens da lista e depois em "
                       "Restaurar.")
            return
        falhas = []
        for nome in nomes:
            origem, _ = ler_info(nome)
            if not origem:
                falhas.append("%s (não sei de onde veio)" % nome)
                continue
            pasta = os.path.dirname(origem)
            try:
                os.makedirs(pasta, exist_ok=True)
                shutil.move(os.path.join(ARQUIVOS, nome),
                            caminho_livre(origem))
                info = os.path.join(INFOS, nome + ".trashinfo")
                if os.path.exists(info):
                    os.remove(info)
            except OSError as e:
                falhas.append("%s (%s)" % (nome, e.strerror))
        self.recarregar()
        if falhas:
            self.aviso("Alguns itens não voltaram", "\n".join(falhas))

    def esvaziar(self):
        n = len(self.loja)
        d = Gtk.MessageDialog(transient_for=self, modal=True,
                              message_type=Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.OK_CANCEL,
                              text="Esvaziar a Lixeira?")
        d.format_secondary_text(
            "%d %s será apagado para sempre. Não dá para desfazer."
            % (n, "item" if n == 1 else "itens"))
        resposta = d.run()
        d.destroy()
        if resposta != Gtk.ResponseType.OK:
            return
        for pasta in (ARQUIVOS, INFOS):
            try:
                for nome in os.listdir(pasta):
                    alvo = os.path.join(pasta, nome)
                    if os.path.isdir(alvo) and not os.path.islink(alvo):
                        shutil.rmtree(alvo, ignore_errors=True)
                    else:
                        try:
                            os.remove(alvo)
                        except OSError:
                            pass
            except OSError:
                pass
        self.recarregar()


def posicao_junto_da_dock(larg, alt):
    """Onde abrir: encostada no fim da Dock, subindo a partir dela.

    Mesma regra da tela "Aplicativos Instalados": nada de coordenada fixa -- a
    Dock e medida agora, entao se ela andar, a janela acompanha. O Plank ocupa
    a largura inteira da tela mas so pinta o pedaco do meio, por isso medimos
    ate onde a janela dele esta pintada em vez de usar a largura dela."""
    try:
        ids = subprocess.run(["xdotool", "search", "--class", "plank"],
                             capture_output=True, text=True, timeout=4).stdout.split()
        for wid in ids:
            g = subprocess.run(["xdotool", "getwindowgeometry", "--shell", wid],
                               capture_output=True, text=True, timeout=4).stdout
            d = dict(l.split("=", 1) for l in g.splitlines() if "=" in l)
            if int(d.get("WIDTH", 0)) <= 1000:
                continue
            px, py = int(d["X"]), int(d["Y"])
            with tempfile.NamedTemporaryFile(suffix=".png") as tmp:
                subprocess.run(["import", "-window", wid, tmp.name],
                               timeout=8, stderr=subprocess.DEVNULL)
                from PIL import Image
                im = Image.open(tmp.name).convert("RGB")
                w, h = im.size
                q = im.load()
                canto = q[2, 2]
                meio = h // 2
                xs = [x for x in range(w)
                      if sum(abs(a - b) for a, b in zip(q[x, meio], canto)) > 30]
            if not xs:
                return None
            # So a horizontal vem dos pixels: a captura da janela do Plank vem
            # composta com o papel de parede, que tem gradiente, e no eixo Y a
            # comparacao acusaria "pintado" onde ha so fundo.
            return (px + xs[-1] - larg - COMPENSA_X,
                    py - alt + DESCE_ATE - COMPENSA_Y)
    except Exception:
        pass
    return None


def main():
    os.makedirs(ARQUIVOS, exist_ok=True)
    os.makedirs(INFOS, exist_ok=True)
    janela = Lixeira()
    janela.connect("destroy", Gtk.main_quit)
    onde = posicao_junto_da_dock(LARGURA, ALTURA)
    if onde:
        janela.move(*onde)
    else:
        janela.set_position(Gtk.WindowPosition.CENTER)
    janela.show_all()
    Gtk.main()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
