#!/usr/bin/env python3
"""Ampulheta de verdade: cursor de espera E cliques bloqueados enquanto o
aplicativo abre.

O problema real que isto resolve: sem retorno nenhum, o usuario clica de novo
achando que nao pegou -- e ai abre DUAS vezes. Aconteceu com o Modo Cinema.

Trocar so o cursor nao bastava. No X11 cada programa manda no cursor da sua
propria janela, entao o cursor de espera do gerenciador de janelas so aparece
sobre a area de trabalho: quem clicou na Dock continua vendo a setinha. E,
mais importante, trocar o cursor nao impede o segundo clique.

XGrabPointer resolve as duas coisas de uma vez: enquanto o ponteiro esta
"agarrado", o cursor de espera vale sobre TODAS as janelas e todo clique vai
para uma janela invisivel nossa, ou seja, e descartado.

REDE DE SEGURANCA -- e o que torna isto seguro de usar:
o X solta qualquer grab automaticamente quando o cliente que o segura fecha a
conexao. Se este processo morrer, travar ou for morto, a maquina volta ao
normal sozinha. Alem disso ha um tempo maximo curto, e o grab e solto assim
que a janela do aplicativo aparece.

O QUE SAIU DAQUI EM 17/08/2026 -- e por que

Ate hoje este script fazia muito mais do que a ampulheta. Em toda abertura de
todo aplicativo ele:

  * escolhia uma "vaga" na grade (tarsila_vaga.py, 14 KB);
  * desenhava um retangulo animado na vaga escolhida, se o app demorasse mais
    de 0,7 s (tarsila_vetor.py, 30 KB, desenhado pelo tarsila-tela-estados,
    1293 linhas, um processo GTK residente);
  * REESCREVIA O rc.xml e disparava um `openbox --reconfigure` para forcar a
    janela a nascer na vaga (tarsila_openbox.py);
  * media a janela recem-nascida e gravava o aprendizado em disco.

Medido nesta box, abrindo a Calculadora pelo caminho real: 3,8 s ate a janela e
91 forks do sistema. Um `openbox --reconfigure` faz o gerenciador reler o
rc.xml inteiro e reaplicar as regras a todas as janelas -- num Amlogic isso
compete com o proprio aplicativo que se esta tentando abrir. O sistema gastava
processamento para escolher onde a janela nasce e, quando escolhia devagar
demais, precisava de um desenho para tapar a espera que ele mesmo causava.

A decisao (17/08/2026, do dono do projeto): cortar os dois. Quem posiciona a
janela agora e o proprio Openbox, pela politica `Smart` + `center` que ja
estava no rc.xml e nunca era usada. Nao ha vaga, nao ha desenho, nao ha
reconfigure, nao ha aprendizado -- e nao ha o processo residente que existia
so para pintar o retangulo.

Ficou o que resolve o problema de verdade: a ampulheta e o bloqueio de cliques.

Uso:  tarsila-abrindo <comando> [argumentos...]
"""

import ctypes
import os
import select
import subprocess
import sys
import time

# Tempo maximo com os cliques bloqueados. Curto de proposito: se o aplicativo
# nao abriu ate aqui, e melhor devolver o controle ao usuario do que insistir.
LIMITE = 8.0
# Depois que o processo termina sem abrir janela, ainda esperamos um pouco: o
# lancador pode ser um script que sai e deixa o programa de verdade subindo.
FOLGA_APOS_SAIR = 2.0
XC_WATCH = 150            # a ampulheta do conjunto de cursores do X

PropertyChangeMask = 1 << 22
PropertyNotify = 28
AnyPropertyType = 0


class X:
    """O bastante de Xlib para esperar por janela nova sem forkar nada.

    Antes esta espera era um laco que rodava `xprop -root` a cada 0,25 s --
    ate 32 subprocessos por abertura, no exato momento em que a maquina esta
    mais ocupada. Aqui a lista de janelas e lida direto do servidor, e o
    processo dorme num select() ate o X avisar que ela mudou.
    """

    def __init__(self):
        self.lib = ctypes.CDLL("libX11.so.6")
        self.lib.XOpenDisplay.restype = ctypes.c_void_p
        self.dpy = self.lib.XOpenDisplay(None)
        if not self.dpy:
            raise OSError("sem display")
        self.lib.XDefaultRootWindow.restype = ctypes.c_ulong
        self.lib.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
        self.raiz = self.lib.XDefaultRootWindow(self.dpy)
        self.lib.XInternAtom.restype = ctypes.c_ulong
        self.lib.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p,
                                         ctypes.c_int]
        self.lista = self.lib.XInternAtom(self.dpy, b"_NET_CLIENT_LIST", False)
        self.lib.XConnectionNumber.argtypes = [ctypes.c_void_p]
        self.fd = self.lib.XConnectionNumber(self.dpy)

    def janelas(self):
        """Conjunto de ids em _NET_CLIENT_LIST, lido direto do servidor."""
        tipo = ctypes.c_ulong()
        formato = ctypes.c_int()
        n = ctypes.c_ulong()
        resto = ctypes.c_ulong()
        dados = ctypes.POINTER(ctypes.c_ulong)()
        self.lib.XGetWindowProperty.argtypes = [
            ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_long,
            ctypes.c_long, ctypes.c_int, ctypes.c_ulong,
            ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_int),
            ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_ulong),
            ctypes.POINTER(ctypes.POINTER(ctypes.c_ulong))]
        rc = self.lib.XGetWindowProperty(
            self.dpy, self.raiz, self.lista, 0, 4096, False, AnyPropertyType,
            ctypes.byref(tipo), ctypes.byref(formato), ctypes.byref(n),
            ctypes.byref(resto), ctypes.byref(dados))
        if rc != 0 or not dados:
            return set()
        try:
            return {dados[i] for i in range(n.value)}
        finally:
            self.lib.XFree(dados)

    def escuta_raiz(self):
        self.lib.XSelectInput(self.dpy, ctypes.c_ulong(self.raiz),
                              ctypes.c_long(PropertyChangeMask))
        self.lib.XFlush(self.dpy)

    def espera_mudanca(self, prazo):
        """Dorme ate o X mandar algo, ou ate o prazo. True se veio evento.

        Os eventos sao consumidos aqui mesmo: sem isso a fila enche e o
        select() para de acordar, porque o que ele vigia e o SOCKET, e o que
        ja chegou dele nao volta a chegar.
        """
        if prazo <= 0:
            return False
        try:
            pronto, _, _ = select.select([self.fd], [], [], prazo)
        except OSError:
            return False
        if not pronto:
            return False
        evento = ctypes.create_string_buffer(256)   # XEvent cabe folgado
        while self.lib.XPending(self.dpy) > 0:
            self.lib.XNextEvent(self.dpy, evento)
        return True

    def fecha(self):
        try:
            self.lib.XCloseDisplay(self.dpy)
        except Exception:
            pass


def main():
    if len(sys.argv) < 2:
        sys.exit("uso: tarsila-abrindo <comando> [argumentos...]")
    cmd = sys.argv[1:]

    try:
        x = X()
    except Exception:
        os.execvp(cmd[0], cmd)          # sem X: so executa, sem ampulheta

    x11 = x.lib
    x11.XCreateFontCursor.restype = ctypes.c_ulong
    x11.XCreateFontCursor.argtypes = [ctypes.c_void_p, ctypes.c_uint]
    cursor = x11.XCreateFontCursor(x.dpy, XC_WATCH)

    x11.XGrabPointer.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int,
                                 ctypes.c_uint, ctypes.c_int, ctypes.c_int,
                                 ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong]

    antes = x.janelas()
    x.escuta_raiz()

    # owner_events=False -> TODO clique vai para a nossa janela e morre ali.
    # ButtonPress|ButtonRelease|PointerMotion, os dois modos Async para nao
    # congelar o servidor caso algo de errado.
    pegou = x11.XGrabPointer(x.dpy, ctypes.c_ulong(x.raiz), False, 4 | 8 | 64,
                             1, 1, 0, ctypes.c_ulong(cursor), 0)
    x11.XFlush(x.dpy)

    try:
        proc = subprocess.Popen(cmd)
    except FileNotFoundError:
        if pegou == 0:
            x11.XUngrabPointer(x.dpy, 0)
            x11.XFlush(x.dpy)
        x.fecha()
        sys.exit("comando nao encontrado: " + cmd[0])

    inicio = time.time()
    saiu_em = None
    try:
        while True:
            falta = LIMITE - (time.time() - inicio)
            if falta <= 0:
                break
            # Meio segundo de teto no select(): o processo pode ter morrido
            # sem abrir janela nenhuma, e isso nao gera evento do X.
            x.espera_mudanca(min(falta, 0.5))
            if x.janelas() - antes:
                break
            if proc.poll() is not None:
                saiu_em = saiu_em or time.time()
                if time.time() - saiu_em >= FOLGA_APOS_SAIR:
                    break
    finally:
        if pegou == 0:
            x11.XUngrabPointer(x.dpy, 0)
            x11.XFlush(x.dpy)
        x.fecha()


if __name__ == "__main__":
    main()
