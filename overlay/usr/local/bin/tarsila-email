#!/bin/bash
# Tarsila Email — launcher principal.
set -euo pipefail

RAIZ="${TARSILA_EMAIL_DIR:-/opt/tarsila-email}"
SETUP="$RAIZ/bin/tarsila-email-setup.py"
APP="$RAIZ/bin/tarsila-email-gtk.py"
CFG="${HOME}/.config/tarsila-email/config.json"

# Migra credenciais do Claws na primeira execução.
python3 -c "
import sys
sys.path.insert(0, '$RAIZ')
from lib import config
config.migrate_from_claws()
config.migrate_data_layout()
" 2>/dev/null || true

if ! python3 -c "import sys; sys.path.insert(0,'$RAIZ'); from lib import config; exit(0 if config.configured() else 1)" 2>/dev/null; then
    exec python3 "$SETUP"
fi

exec python3 "$APP" "$@"
