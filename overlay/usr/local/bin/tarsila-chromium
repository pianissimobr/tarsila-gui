#!/bin/bash
# ============================================================================
#  tarsila-chromium.sh — Navegador Tarsila (versão final unificada)
#  Chromium otimizado para ARM 2GB + zRam. Componentes integrados:
#    • Flags de runtime (processos, jitless, caches, GPU/vídeo, movimento)
#    • Modo Cinema (opt-in, mpv via native messaging, detecção em camadas)
#    • Adblock nativo via declarativeNetRequest (motor C++ do Chromium)
#    • Modo Leve (corta backdrop-filter/animações/sombras das páginas)
#    • Otimização de imagens (lazy decode + menor candidato do srcset)
#
#  Filosofia: "patch sem compilar". Chromium do repositório Debian, zero fork.
#
#  USO:
#    sudo ./tarsila-chromium.sh instalar   # instala tudo (idempotente)
#    tarsila-chromium                      # abre o navegador otimizado
#    tarsila-chromium https://site.com     # abre uma URL
#
#  CHAVES DE TESTE A/B (variáveis de ambiente):
#    TARSILA_JITLESS=0   desliga jitless do V8 (se SPAs ficarem lentos)
#    TARSILA_HWDEC=0     desliga decodificação de vídeo por hardware
#    TARSILA_GPU=0       desliga GPU de vez (chips fbdev / sem GL)
#    TARSILA_TIER_B=1    liga flags experimentais (validar no hardware)
#    TARSILA_CINEMA=0    não carrega a extensão Tarsila
#    TARSILA_DEBUG=1     imprime as flags e sai
#
#  Wayland vs X11 é detectado automaticamente.
#  Modo Leve: nível configurável em /usr/share/tarsila/cinema-ext/modo_leve.js
# ============================================================================

set -euo pipefail

# ----------------------------------------------------------------------------
# Constantes: o KEY fixa o ID da extensão independente do caminho — necessário
# para o native messaging saber qual extensão pode falar com o host local.
# ----------------------------------------------------------------------------
EXT_ID="bjgpobchjbpaiibjojkhlokdakpjbkde"
EXT_KEY=""

PREFIX="${TARSILA_PREFIX:-}"   # vazio em produção; usado só para testes
EXT_DIR="$PREFIX/usr/share/tarsila/cinema-ext"
HOST_BIN="$PREFIX/usr/local/lib/tarsila/cinema_host.py"
NM_DIR="$PREFIX/etc/chromium/native-messaging-hosts"
DESKTOP_FILE="$PREFIX/usr/share/applications/tarsila-chromium.desktop"
SELF_DEST="$PREFIX/usr/local/bin/tarsila-chromium"

# ============================================================================
#  MODO INSTALADOR:  sudo ./tarsila-chromium.sh instalar
# ============================================================================
if [ "${1:-}" = "instalar" ]; then

    echo ">> Instalando Navegador Tarsila..."
    mkdir -p "$EXT_DIR" "$(dirname "$HOST_BIN")" "$NM_DIR" \
             "$(dirname "$DESKTOP_FILE")" "$(dirname "$SELF_DEST")"

    # ------------------------------------------------------------------
    # 1/7 — Manifest da extensão (MV3)
    # declarativeNetRequest = adblock executado pelo motor C++ nativo do
    # Chromium na camada de rede; a extensão só declara as regras.
    # ------------------------------------------------------------------
    cat > "$EXT_DIR/manifest.json" <<MANIFEST
{
  "manifest_version": 3,
  "key": "$EXT_KEY",
  "name": "Tarsila",
  "version": "2.0",
  "description": "Modo Cinema, bloqueio de anúncios e Modo Leve para este computador.",
  "permissions": ["nativeMessaging", "activeTab"],
  "background": { "service_worker": "background.js" },
  # declarative_net_request DESATIVADO: bug reproduzido no Chromium 150.0.7871.124
  # (Debian trixie) -- ate uma extensao minima com 1 regra DNR falha ao carregar
  # ("rules.json: Internal error while parsing rules."), sem relacao com o
  # conteudo de rules.json (testado com JSON valido minimo). rules.json continua
  # em disco pronto para reativar quando o bug for corrigido upstream/pacote.
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["modo_leve.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["cinema.js", "imagens.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
MANIFEST

    # ------------------------------------------------------------------
    # 2/7 — Adblock DNR: lista inicial (2ª camada; a 1ª é o /etc/hosts).
    # O hosts mata domínios inteiros para todo o sistema; o DNR pega
    # padrões de URL que o hosts não alcança. Lista conservadora de
    # redes de anúncio/rastreamento; expandir com gerador EasyList->DNR.
    # ------------------------------------------------------------------
    cat > "$EXT_DIR/rules.json" <<'RULES'
[
  {"id":1,"action":{"type":"block"},"condition":{"urlFilter":"||doubleclick.net^"}},
  {"id":2,"action":{"type":"block"},"condition":{"urlFilter":"||googlesyndication.com^"}},
  {"id":3,"action":{"type":"block"},"condition":{"urlFilter":"||google-analytics.com^"}},
  {"id":4,"action":{"type":"block"},"condition":{"urlFilter":"||adservice.google.com^"}},
  {"id":5,"action":{"type":"block"},"condition":{"urlFilter":"||connect.facebook.net^"}},
  {"id":6,"action":{"type":"block"},"condition":{"urlFilter":"||taboola.com^"}},
  {"id":7,"action":{"type":"block"},"condition":{"urlFilter":"||outbrain.com^"}},
  {"id":8,"action":{"type":"block"},"condition":{"urlFilter":"||criteo.com^"}},
  {"id":9,"action":{"type":"block"},"condition":{"urlFilter":"||criteo.net^"}},
  {"id":10,"action":{"type":"block"},"condition":{"urlFilter":"||scorecardresearch.com^"}},
  {"id":11,"action":{"type":"block"},"condition":{"urlFilter":"||hotjar.com^"}},
  {"id":12,"action":{"type":"block"},"condition":{"urlFilter":"||adnxs.com^"}},
  {"id":13,"action":{"type":"block"},"condition":{"urlFilter":"||pubmatic.com^"}},
  {"id":14,"action":{"type":"block"},"condition":{"urlFilter":"||rubiconproject.com^"}},
  {"id":15,"action":{"type":"block"},"condition":{"urlFilter":"||amazon-adsystem.com^"}},
  {"id":16,"action":{"type":"block"},"condition":{"urlFilter":"||moatads.com^"}},
  {"id":17,"action":{"type":"block"},"condition":{"urlFilter":"||chartbeat.com^"}},
  {"id":18,"action":{"type":"block"},"condition":{"urlFilter":"||smartadserver.com^"}},
  {"id":19,"action":{"type":"block"},"condition":{"urlFilter":"||fonts.googleapis.com^"}},
  {"id":20,"action":{"type":"block"},"condition":{"urlFilter":"||fonts.gstatic.com^"}},
  {"id":21,"priority":2,"action":{"type":"allow"},"condition":{"urlFilter":"||fonts.googleapis.com/icon"}},
  {"id":22,"priority":2,"action":{"type":"allow"},"condition":{"urlFilter":"||fonts.gstatic.com/s/materialicons"}},
  {"id":23,"priority":2,"action":{"type":"allow"},"condition":{"urlFilter":"||fonts.gstatic.com/s/materialsymbols"}},
  {"id":24,"priority":2,"action":{"type":"allow"},"condition":{"urlFilter":"||fonts.googleapis.com/css2?family=Material"}}
]
RULES
    # Regras 19-24 (estratégia de fontes): bloqueiam Google Fonts porque as
    # famílias campeãs (Roboto, Open Sans, Lato, Montserrat, Inter, Noto)
    # são instaladas LOCALMENTE pelo instalador — o site pede "Roboto", o
    # fontconfig entrega a Roboto do disco: renderização idêntica, zero
    # download/parse. Fontes exóticas caem para sans-serif com dignidade.
    # As regras 21-24 (allow, prioridade maior) EXCETUAM icon fonts —
    # bloqueá-las viraria quadradinhos onde deveria haver ícones de menu.
    # A 24 cobre o endpoint css2 do Material Symbols (geração atual),
    # que a 21 (endpoint /icon, geração antiga) não alcança.

    # ------------------------------------------------------------------
    # 3/7 — Modo Leve: CSS de sobrescrita aplicado pelo motor de
    # renderização (não é JS por elemento — custo ~zero).
    # NIVEL 1: mata backdrop-filter (o pior vilão de GPU fraca).
    # NIVEL 2: + animações/transições contínuas e sombras.
    # Efeito colateral aceito: cards perdem sombra; usamos .01ms (não 0)
    # para eventos transitionend continuarem disparando.
    # ------------------------------------------------------------------
    cat > "$EXT_DIR/modo_leve.js" <<'LEVE'
(() => {
  "use strict";
  const NIVEL = 2; // 1 = só backdrop-filter | 2 = + animações e sombras

  let css =
    "*{backdrop-filter:none!important;-webkit-backdrop-filter:none!important;}";

  if (NIVEL >= 2) {
    css +=
      "*,*::before,*::after{" +
      "animation-duration:.01ms!important;" +
      "animation-iteration-count:1!important;" +
      "transition-duration:.01ms!important;" +
      "scroll-behavior:auto!important;" +
      "box-shadow:none!important;" +
      "text-shadow:none!important;}";
  }

  const style = document.createElement("style");
  style.id = "tarsila-modo-leve";
  style.textContent = css;
  (document.head || document.documentElement).appendChild(style);
})();
LEVE

    # ------------------------------------------------------------------
    # 4/7 — Otimização de imagens.
    # Lembrete técnico: RAM de imagem = largura x altura x 4 bytes,
    # independente da compressão do arquivo. Por isso o alvo é dimensão
    # e quantidade decodificada, não "qualidade":
    #   a) loading=lazy + decoding=async: imagem fora da tela não decodifica
    #   b) srcset: força o MENOR candidato que o site oferece
    # ------------------------------------------------------------------
    cat > "$EXT_DIR/imagens.js" <<'IMG'
(() => {
  "use strict";

  function larguraDoCandidato(cand) {
    const m = cand.match(/\s(\d+)w\s*$/);
    return m ? parseInt(m[1], 10) : Number.MAX_SAFE_INTEGER;
  }

  function otimizar(img) {
    if (img.dataset.tarsilaOk) return;
    img.dataset.tarsilaOk = "1";
    img.loading = "lazy";
    img.decoding = "async";

    if (img.srcset && img.srcset.includes(",")) {
      const candidatos = img.srcset.split(",").map(s => s.trim()).filter(Boolean);
      let menor = candidatos[0];
      for (const c of candidatos) {
        if (larguraDoCandidato(c) < larguraDoCandidato(menor)) menor = c;
      }
      if (larguraDoCandidato(menor) !== Number.MAX_SAFE_INTEGER) {
        img.srcset = menor;
        img.sizes = "";
      }
    }
  }

  document.querySelectorAll("img").forEach(otimizar);

  let agendado = false;
  new MutationObserver(() => {
    if (agendado) return;
    agendado = true;
    setTimeout(() => {
      agendado = false;
      document.querySelectorAll("img:not([data-tarsila-ok])").forEach(otimizar);
    }, 1000);
  }).observe(document.documentElement, { childList: true, subtree: true });
})();
IMG

    # ------------------------------------------------------------------
    # 5/7 — Modo Cinema: content script (detecção em camadas + botão).
    # REGRA DE UX: o botão só aparece se a detecção confirmar que vai
    # funcionar. blob:/DRM nunca mostra botão. Falha degrada para a
    # experiência padrão, nunca tela preta.
    # ------------------------------------------------------------------
    cat > "$EXT_DIR/cinema.js" <<'CINEMA'
(() => {
  "use strict";

  // Camada 1: sites que o yt-dlp comprovadamente extrai (lista conservadora).
  const SITES_SUPORTADOS = [
    "youtube.com", "youtu.be", "vimeo.com", "dailymotion.com",
    "archive.org", "globoplay.globo.com"
  ];

  const hostOk = SITES_SUPORTADOS.some(s =>
    location.hostname === s || location.hostname.endsWith("." + s));

  // Camada 2: <video> com fonte direta (mp4/webm/HLS).
  function fonteDireta() {
    for (const v of document.querySelectorAll("video")) {
      const src = v.currentSrc || v.src || "";
      if (/^https?:\/\/.+\.(mp4|webm|m3u8)(\?|$)/i.test(src)) return src;
      for (const s of v.querySelectorAll("source")) {
        if (/^https?:\/\/.+\.(mp4|webm|m3u8)(\?|$)/i.test(s.src)) return s.src;
      }
    }
    return null;
  }

  let botao = null;

  function avaliar() {
    const direto = fonteDireta();
    const temVideo = document.querySelector("video") !== null;
    const elegivel = (hostOk && temVideo) || direto !== null;

    if (elegivel && !botao) {
      botao = document.createElement("button");
      botao.textContent = "\uD83C\uDFAC Modo Cinema";
      botao.setAttribute("style",
        "position:fixed;bottom:16px;right:16px;z-index:2147483647;" +
        "padding:10px 16px;border-radius:24px;border:none;cursor:pointer;" +
        "background:#1a1a2e;color:#fff;font:600 14px sans-serif;" +
        "box-shadow:0 2px 10px rgba(0,0,0,.4)");
      botao.addEventListener("click", () => {
        botao.textContent = "\u23F3 Abrindo...";
        botao.disabled = true;
        chrome.runtime.sendMessage(
          { url: direto || location.href, titulo: document.title },
          (resp) => {
            if (resp && resp.ok) {
              document.querySelectorAll("video").forEach(v => v.pause());
              botao.textContent = "\uD83C\uDFAC Modo Cinema";
              botao.disabled = false;
            } else {
              botao.textContent = "Indispon\u00edvel \u2014 assista aqui mesmo";
              setTimeout(() => { if (botao) { botao.remove(); botao = null; } }, 4000);
            }
          });
      });
      document.body.appendChild(botao);
    } else if (!elegivel && botao) {
      botao.remove();
      botao = null;
    }
  }

  avaliar();
  let agendado = false;
  new MutationObserver(() => {
    if (agendado) return;
    agendado = true;
    setTimeout(() => { agendado = false; avaliar(); }, 1500);
  }).observe(document.documentElement, { childList: true, subtree: true });
})();
CINEMA

    # ------------------------------------------------------------------
    # 6/7 — Service worker + host nativo (mpv) + manifesto NM
    # ------------------------------------------------------------------
    cat > "$EXT_DIR/background.js" <<'BG'
chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
  chrome.runtime.sendNativeMessage("br.tarsila.cinema", msg, (resp) => {
    if (chrome.runtime.lastError) {
      sendResponse({ ok: false, erro: chrome.runtime.lastError.message });
    } else {
      sendResponse(resp || { ok: false });
    }
  });
  return true; // resposta assíncrona
});
BG

    cat > "$HOST_BIN" <<'HOST'
#!/usr/bin/env python3
"""Tarsila Modo Cinema — host nativo.

Recebe uma URL da extensão e abre no mpv com decodificação por hardware.
O mpv resolve sites via yt-dlp (hook ytdl embutido); URLs diretas
(mp4/m3u8/webm) tocam sem intermediário.

POLÍTICA: reproduz, nunca salva em disco.
"""
import json
import struct
import subprocess
import sys

# hwdec=auto-safe tenta v4l2m2m/drm e cai para software sem crashar.
MPV_CMD = [
    "mpv", "--fs", "--hwdec=auto-safe",
    "--ytdl=yes",
    "--ytdl-format=best[height<=?720]",  # teto 720p: honesto com 2GB de RAM
    "--no-terminal",
    "--osc=yes",
]


def ler_mensagem():
    raw_len = sys.stdin.buffer.read(4)
    if len(raw_len) < 4:
        sys.exit(0)
    msg_len = struct.unpack("<I", raw_len)[0]
    return json.loads(sys.stdin.buffer.read(msg_len).decode("utf-8"))


def responder(obj):
    data = json.dumps(obj).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("<I", len(data)))
    sys.stdout.buffer.write(data)
    sys.stdout.buffer.flush()


def main():
    msg = ler_mensagem()
    url = msg.get("url", "")
    if not url.startswith(("http://", "https://")):
        responder({"ok": False, "erro": "URL inválida"})
        return
    try:
        subprocess.Popen(
            MPV_CMD + [url],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        responder({"ok": True})
    except FileNotFoundError:
        responder({"ok": False, "erro": "mpv não instalado"})
    except Exception as exc:
        responder({"ok": False, "erro": str(exc)})


if __name__ == "__main__":
    main()
HOST
    chmod +x "$HOST_BIN"

    cat > "$NM_DIR/br.tarsila.cinema.json" <<NMJSON
{
  "name": "br.tarsila.cinema",
  "description": "Tarsila Modo Cinema",
  "path": "/usr/local/lib/tarsila/cinema_host.py",
  "type": "stdio",
  "allowed_origins": ["chrome-extension://$EXT_ID/"]
}
NMJSON

    # ------------------------------------------------------------------
    # 7/7 — Atalho no menu + este script como comando do sistema
    # ------------------------------------------------------------------
    cat > "$DESKTOP_FILE" <<'DESKTOP'
[Desktop Entry]
Name=Navegador Tarsila
Comment=Navegador otimizado para este computador
Exec=/usr/local/bin/tarsila-chromium %U
Terminal=false
Type=Application
Icon=chromium
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
DESKTOP

    cp "$0" "$SELF_DEST"
    chmod +x "$SELF_DEST"

    # ------------------------------------------------------------------
    # Fontes locais: as famílias que dominam a web, instaladas uma vez
    # (~40MB de disco — o recurso barato) em troca de zero download,
    # zero parse e menos RAM para sempre. Não-fatal se estiver offline.
    # ------------------------------------------------------------------
    FONTES="fonts-roboto fonts-open-sans fonts-lato fonts-montserrat fonts-inter fonts-noto-core"
    if command -v apt-get >/dev/null 2>&1; then
        echo ">> Instalando fontes locais (substituem o Google Fonts bloqueado)..."
        apt-get install -y $FONTES \
            || echo "AVISO: instale depois com: sudo apt install $FONTES"
    else
        echo "AVISO: apt-get indisponível; instale manualmente: $FONTES"
    fi

    # ------------------------------------------------------------------
    # Ícones do Material instalados localmente (2ª camada de proteção
    # contra tofu, além das regras allow 21-24 do DNR). Não há pacote
    # Debian oficial — o fonts-materialdesignicons-webfont do repositório
    # é o projeto comunitário MDI, com codepoints diferentes: NÃO serve.
    # Baixamos os TTFs do repositório oficial da Google (Apache 2.0).
    # O nome de família embutido no TTF ("Material Icons", "Material
    # Symbols Outlined") é o que o fontconfig casa com o pedido do site.
    # ------------------------------------------------------------------
    ICON_DIR="$PREFIX/usr/share/fonts/truetype/tarsila"
    mkdir -p "$ICON_DIR"
    GH="https://raw.githubusercontent.com/google/material-design-icons/master"
    baixar() {  # baixar <url> <destino> — não-fatal
        if command -v curl >/dev/null 2>&1; then
            curl -fsSL "$1" -o "$2" || return 1
        elif command -v wget >/dev/null 2>&1; then
            wget -q "$1" -O "$2" || return 1
        else
            return 1
        fi
    }
    echo ">> Baixando ícones do Material (repositório oficial da Google)..."
    OK_ICONES=1
    baixar "$GH/font/MaterialIcons-Regular.ttf" \
           "$ICON_DIR/MaterialIcons-Regular.ttf" || OK_ICONES=0
    baixar "$GH/variablefont/MaterialSymbolsOutlined%5BFILL%2CGRAD%2Copsz%2Cwght%5D.ttf" \
           "$ICON_DIR/MaterialSymbolsOutlined.ttf" || OK_ICONES=0
    baixar "$GH/variablefont/MaterialSymbolsRounded%5BFILL%2CGRAD%2Copsz%2Cwght%5D.ttf" \
           "$ICON_DIR/MaterialSymbolsRounded.ttf" || OK_ICONES=0
    if [ "$OK_ICONES" = "1" ]; then
        command -v fc-cache >/dev/null 2>&1 && fc-cache -f "$ICON_DIR" >/dev/null 2>&1 || true
        echo "   Ícones instalados em $ICON_DIR"
    else
        echo "AVISO: download de ícones falhou (offline?). As regras allow do"
        echo "       DNR seguram sozinhas; rode 'instalar' de novo com internet."
    fi

    echo ">> Instalado. Próximos passos:"
    echo "   1. Dependências:        sudo apt install chromium mpv yt-dlp"
    echo "   2. Navegador padrão:    xdg-settings set default-web-browser tarsila-chromium.desktop"
    echo "   3. Validar GPU:         abrir chrome://gpu no dispositivo"
    echo "   4. Adblock 1ª camada:   /etc/hosts (fora deste script)"
    echo "   5. Validar fontes:      sites devem renderizar Roboto/Open Sans"
    echo "      locais; ícones de menu não podem virar quadradinhos"
    exit 0
fi

# ============================================================================
#  MODO NAVEGADOR (padrão)
# ============================================================================

CHROMIUM_BIN=""
for bin in chromium chromium-browser /usr/lib/chromium/chromium; do
    if command -v "$bin" >/dev/null 2>&1; then
        CHROMIUM_BIN="$bin"
        break
    fi
done
if [ -z "$CHROMIUM_BIN" ]; then
    echo "ERRO: Chromium não encontrado. Instale com: sudo apt install chromium" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Cada chave pode vir de um ARQUIVO em ~/.config/tarsila/, com precedencia
# sobre a variavel de ambiente. Motivo: as variaveis moram no
# ~/.config/openbox/environment e so mudam no proximo login -- inuteis para a
# tela de Ajustes do Navegador (pagina de opcoes da extensao cinema-ext), que
# grava esses arquivos pelo host nativo. Assim a mudanca vale no proximo
# lancamento do navegador, sem deslogar.
_pref() {   # _pref <arquivo> <valor-atual>
    if [ -r "$HOME/.config/tarsila/$1" ]; then
        read -r _v < "$HOME/.config/tarsila/$1"
        case "$_v" in 0|1) printf '%s' "$_v"; return ;; esac
    fi
    printf '%s' "$2"
}
TARSILA_JITLESS="$(_pref jitless "${TARSILA_JITLESS:-1}")"
TARSILA_TIER_B="$(_pref tierb "${TARSILA_TIER_B:-1}")"  # CPU (4x A35) satura com varias abas
# TARSILA_GPU tambem pode vir de um ARQUIVO, que tem precedencia sobre a
# variavel de ambiente. Motivo: a variavel mora no ~/.config/openbox/environment
# e so muda no proximo login -- inutil para alternar durante um diagnostico,
# e inutil para uma tela de configuracao. Com o arquivo, vale no proximo
# lancamento do navegador.
#   echo 0 > ~/.config/tarsila/gpu   -> desliga a GPU do Chromium
#   echo 1 > ~/.config/tarsila/gpu   -> liga
#   rm    ~/.config/tarsila/gpu      -> volta a mandar a variavel de ambiente
TARSILA_GPU="$(_pref gpu "${TARSILA_GPU:-1}")"
TARSILA_HWDEC="$(_pref hwdec "${TARSILA_HWDEC:-1}")"
TARSILA_CINEMA="$(_pref cinema "${TARSILA_CINEMA:-1}")"
TARSILA_DEBUG="${TARSILA_DEBUG:-0}"

FLAGS=()

# ============================================================================
#  TIER A — CONFIRMADAS, ORDENADAS POR IMPACTO
# ============================================================================

# [A1] MAIOR GANHO: consolidação de processos. Em 2GB é a diferença entre
# navegar e travar por OOM.
FLAGS+=(
    "--process-per-site"
    "--disable-site-isolation-trials"
)

# [A2] Modo dispositivo de baixo custo (versão runtime de is_low_end_device):
# buffers menores, menos threads, cache de imagens decodificadas encolhido.

# [A3] V8 jitless — chave A/B. RAM do JS despenca; SPAs pesados ficam mais
# lentos. Bônus: jitless já desabilita WebAssembly por tabela.
if [ "$TARSILA_JITLESS" = "1" ]; then
    FLAGS+=( "--js-flags=--jitless" )
else
    FLAGS+=( "--js-flags=--no-expose-wasm" )
fi

# [A4] Cache de disco mínimo: poupa SD/eMMC e evita UI travada em I/O.
FLAGS+=(
    "--disk-cache-size=31457280"
    "--media-cache-size=20971520"
)

# [A5] Caches gráficos da Skia.
FLAGS+=(
    "--skia-font-cache-limit-mb=8"
    "--skia-resource-cache-limit-mb=32"
)

# [A6] Higiene de baixo recurso.
FLAGS+=(
    "--no-first-run"
    "--no-default-browser-check"
    "--disable-background-networking"
    "--disable-breakpad"
    "--disable-crash-reporter"
    "--disable-component-update"
    "--disable-domain-reliability"
    "--disable-sync"
    "--disable-translate"
    "--metrics-recording-only"
    "--mute-audio-when-backgrounded"
)

# [A7] Movimento e imagens (complementa o Modo Leve da extensão):
#   --disable-smooth-scrolling: scroll animado é trabalho contínuo de compositor
#   --force-prefers-reduced-motion: sites bem-feitos desligam animações sozinhos
#   imageAnimationPolicy=2: congela GIFs animados (cada frame decodificado
#     vive na RAM; portal de notícia brasileiro adora GIF)
#   --wm-window-animations-disabled: animações de janela da própria UI
# Nota honesta: sombras da UI interna do Chromium não têm flag de runtime —
# é território de fork, e o custo delas é irrisório perto do conteúdo.
FLAGS+=(
    "--disable-smooth-scrolling"
    "--force-prefers-reduced-motion"
    "--blink-settings=imageAnimationPolicy=2"
    "--wm-window-animations-disabled"
)

# [A7c] Anuncia suporte a TOQUE. Sem isto, a versao mobile dos sites nem
# registra os manipuladores de gesto: medido nesta box, com user-agent de iPad
# o ontouchstart continuava false, e arrastar a barra de progresso nao fazia
# nada. A flag apenas ANUNCIA a capacidade -- quem converte arrasto de mouse em
# touchstart/touchmove/touchend e o toque.js da extensao cinema-ext.
# E global de proposito: e capacidade do navegador, nao da para ser por site.
# O mouse continua funcionando normalmente; o toque.js so age em ARRASTO,
# nunca em clique simples, para nao disparar botao em dobro.
FLAGS+=( "--touch-events=enabled" )

# [A7b] Rede e antecipação: RAM que vaza antes de o usuário pedir qualquer coisa.
#   --autoplay-policy: vídeo só decodifica após clique (portal com 3 autoplays
#     = 3 decodificadores ativos de graça; maior buraco restante)
#   --no-pings: mata auditoria de hyperlink (<a ping=...>)
#   --disable-notifications: site com permissão de push mantém service worker
#     acordado para sempre; no perfil Tarsila, notificação web não tem função
FLAGS+=(
    "--autoplay-policy=user-gesture-required"
    "--no-pings"
    "--disable-notifications"
)

# [A8] Descarte de abas nativo (Memory Saver): aba de fundo é descartada e o
# zRam (swappiness=100) comprime o resto.
FEATURES_ON=( "HighEfficiencyModeAvailable" "MemorySaverMemoryUsageInDiscardDialog" )
# Prerender2 = pré-renderização especulativa de páginas inteiras que o usuário
# talvez nem visite: uma "aba fantasma" comendo RAM e 4G. Em 2GB, fora.
FEATURES_OFF=( "CalculateNativeWinOcclusion" "Prerender2" )

# [A11] Sites nao devem "acordar" sozinhos sem aba aberta: Background/Periodic
# Sync deixam o service worker de um site rodar em segundo plano so pra
# sincronizar depois que a aba fechou (uso de CPU/rede fantasma). Privacy
# Sandbox (Topics/Fledge/Attribution) calcula perfis de anuncio em background
# mesmo sem nenhum site pedir - custo que ninguem usando este navegador
# precisa pagar. TabHoverCardImages gera miniatura da aba a cada hover.
FEATURES_OFF+=( "BackgroundSync" "PeriodicBackgroundSync" "BackgroundFetch" "PrivacySandboxSettings4" "PrivacySandboxAdsAPIsOverride" "TabHoverCardImages" "BackForwardCache" )

# [A9] Detecção do servidor gráfico: Wayland / X11 / sem GL
if [ "$TARSILA_GPU" = "0" ]; then
    # Melhor que deixar o SwiftShader emular GL comendo CPU e RAM.
    FLAGS+=( "--disable-gpu" )

elif [ -n "${WAYLAND_DISPLAY:-}" ]; then
    FLAGS+=( "--ozone-platform=wayland" )
    if [ "$TARSILA_HWDEC" = "1" ]; then
        FLAGS+=( "--ignore-gpu-blocklist" )
        FEATURES_ON+=( "VaapiVideoDecodeLinuxGL" "AcceleratedVideoDecodeLinuxGL" )
    fi

elif [ -n "${DISPLAY:-}" ]; then
    # --use-angle=gles: EGL/GLES direto no Mali (panfrost/lima), sem GLX.
    FLAGS+=(
        "--ozone-platform=x11"
        "--use-angle=gles"
    )
    if [ "$TARSILA_HWDEC" = "1" ]; then
        FLAGS+=( "--ignore-gpu-blocklist" )
        FEATURES_ON+=( "VaapiVideoDecodeLinuxGL" "AcceleratedVideoDecodeLinuxGL" )
    fi

else
    echo "AVISO: nenhum servidor gráfico detectado (WAYLAND_DISPLAY/DISPLAY vazios)." >&2
    FLAGS+=( "--disable-gpu" )
fi
# Validação por dispositivo: chrome://gpu deve mostrar
# "Video Decode: Hardware accelerated". Tela preta/crash -> TARSILA_HWDEC=0;
# nem GL básico -> TARSILA_GPU=0. Anotar por chip na matriz do projeto.

# [A10] Extensão Tarsila (Modo Cinema + adblock DNR + Modo Leve + imagens)
# ARMADILHA (2026-07-26): o indexador de regras DNR do Chromium ESCREVE um
# diretorio _metadata/ DENTRO da pasta da extensao. Em /usr/share (root, so
# leitura) isso falha com "rules.json: Internal error while parsing rules" e a
# extensao INTEIRA deixa de carregar (Modo Leve e Modo Cinema juntos). Por isso
# a fonte canonica fica em /usr/share e carregamos de uma copia no HOME,
# ressincronizada quando a fonte muda. NAO tornar /usr/share gravavel: a
# extensao tem permissao nativeMessaging e roda em toda pagina.
EXT_SRC="/usr/share/tarsila/cinema-ext"
EXT_USR="${XDG_DATA_HOME:-$HOME/.local/share}/tarsila/cinema-ext"
if [ "$TARSILA_CINEMA" = "1" ] && [ -f "$EXT_SRC/manifest.json" ]; then
    # Compara a pasta INTEIRA, nao so manifest/rules: a extensao tem varios
    # .js (modo_leve, cinema, imagens, fundo, sites-mobile, ua-main) e olhar so
    # dois arquivos fazia mudanca em qualquer outro NUNCA chegar ao usuario.
    if [ ! -f "$EXT_USR/manifest.json" ] \
       || [ -n "$(find "$EXT_SRC" -maxdepth 1 -type f \
                  -newer "$EXT_USR/manifest.json" -print -quit 2>/dev/null)" ]; then
        mkdir -p "$EXT_USR"
        # Copiar a pasta INTEIRA. Filtrar por extensao ja mordeu duas vezes:
        # antes so json+js, e a pagina de opcoes (.html) nunca chegava --
        # o Chromium recusava a extensao com "Could not load options page".
        # O _metadata e do proprio Chromium (indice do DNR): nao copiar.
        # Apaga antes de copiar: sem isto, arquivo removido da fonte sobrevivia
    # para sempre na copia do HOME. Preserva _metadata/, que e do Chromium.
    find "$EXT_USR" -maxdepth 1 -type f -delete 2>/dev/null
    find "$EXT_SRC" -maxdepth 1 -type f -exec cp -f {} "$EXT_USR"/ \; 2>/dev/null
    fi
    FLAGS+=( "--load-extension=$EXT_USR" )
fi

# ============================================================================
#  TIER B — EXISTEM, MAS VARIAM POR VERSÃO. TARSILA_TIER_B=1 e validar em
#  chrome://process-internals e chrome://discards.
# ============================================================================
if [ "$TARSILA_TIER_B" = "1" ]; then
    # [B1] Coleira nos renderers: historicamente honrada com site isolation
    # desligado; houve versões de desktop que ignoravam. Contar processos.
    FLAGS+=( "--renderer-process-limit=2" )
    # [B2] Congelamento de abas em background (nomes mudam entre versões).
    FEATURES_ON+=( "freeze-user-agent" )
    # [B3] Zera duração de todas as animações do compositor (marreta global
    # de movimento). Testar se algum site quebra menu/carrossel.
    FLAGS+=( "--animation-duration-scale=0" )
fi

IFS=','; FLAGS+=( "--enable-features=${FEATURES_ON[*]}" "--disable-features=${FEATURES_OFF[*]}" ); unset IFS

# ============================================================================
#  VETADO DE PROPÓSITO:
#  --no-sandbox: usuário Tarsila digita URL livre; desligar sandbox em
#     desktop de uso geral troca RAM por risco real.
#  Vídeo padrão fora do navegador: Modo Cinema é OPT-IN com detecção em
#     camadas; DRM/blob fica no navegador para sempre; reproduz, nunca baixa.
#  Re-compressão de imagens via proxy ("Modo Economia de Dados"): possível
#     (padrão Bandwidth Hero), mas exige infra própria e todo o tráfego de
#     imagem passando por ela — decisão de produto para fase futura.
#  UI do Chromium sem sombras nativas: sem flag de runtime; exigiria fork.
# ============================================================================

if [ "$TARSILA_DEBUG" = "1" ]; then
    echo "Binário: $CHROMIUM_BIN"
    printf 'Flag: %s\n' "${FLAGS[@]}"
    exit 0
fi

exec "$CHROMIUM_BIN" "${FLAGS[@]}" "$@"
