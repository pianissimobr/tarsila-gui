#!/bin/bash
NAME="${1:-}"; ROOTPW="${2:-}"
[ -n "$NAME" ] || { echo "Uso: $0 <usuario> [senha_do_root]" >&2; exit 2; }
read -r USERPW || USERPW=""

if [ -z "$USERPW" ]; then
  echo "ERRO: senha do usuario vazia" >&2
  exit 3
fi

HOME_DIR="$(getent passwd "$NAME" 2>/dev/null | cut -d: -f6)" || true
if [ -z "${HOME_DIR:-}" ]; then
  HOME_DIR="/home/$NAME"
  useradd -m -s /bin/bash -c "$NAME" -G sudo "$NAME" || {
    echo "ERRO: nao foi possivel criar o usuario $NAME" >&2
    exit 4
  }
else
  usermod -aG sudo "$NAME" 2>/dev/null || true
fi
echo "$NAME:$USERPW" | chpasswd || {
  echo "ERRO: nao foi possivel definir a senha do usuario" >&2
  exit 5
}

if [ -n "$ROOTPW" ] && [ "$ROOTPW" != "none" ]; then
  echo "$ROOTPW" | chpasswd root 2>/dev/null || true
fi

if [ -d /usr/share/tarsila/skel ]; then
  cp -a /usr/share/tarsila/skel/.config "$HOME_DIR/" 2>/dev/null || true
  cp -a /usr/share/tarsila/skel/user-dirs.* "$HOME_DIR/" 2>/dev/null || true
  cp -a /usr/share/tarsila/skel/.local "$HOME_DIR/" 2>/dev/null || true
  if [ -f /usr/share/tarsila/skel/plank-dconf.ini ] && which dconf >/dev/null 2>&1; then
    sudo -u "$NAME" dbus-run-session -- dconf load /net/launchpad/plank/ < /usr/share/tarsila/skel/plank-dconf.ini 2>/dev/null || true
  fi
fi

if [ -d /usr/share/tarsila/openbox-home ]; then
  mkdir -p "$HOME_DIR/.config"
  for d in openbox polybar xsettingsd dunst mpv; do
    [ -d "/usr/share/tarsila/openbox-home/$d" ] || continue
    cp -a "/usr/share/tarsila/openbox-home/$d" "$HOME_DIR/.config/$d"
  done
  [ -f /usr/share/tarsila/openbox-home/dot-xsession ] && cp -f /usr/share/tarsila/openbox-home/dot-xsession "$HOME_DIR/.xsession"
  chmod +x "$HOME_DIR/.config/openbox/autostart" "$HOME_DIR/.config/polybar/"*.sh 2>/dev/null || true
  chmod +x "$HOME_DIR/.xsession" 2>/dev/null || true
fi

mkdir -p "$HOME_DIR/.config/tarsila"
[ -f "$HOME_DIR/.config/tarsila/tema" ] || echo padrao > "$HOME_DIR/.config/tarsila/tema"

if [ -f /usr/local/lib/tarsila/sudoers-template ]; then
  sed "s/^alan /$NAME /" /usr/local/lib/tarsila/sudoers-template > "/etc/sudoers.d/tarsila-config-$NAME"
  chmod 440 "/etc/sudoers.d/tarsila-config-$NAME"
  visudo -c >/dev/null 2>&1 || rm -f "/etc/sudoers.d/tarsila-config-$NAME"
fi

chown -R "$NAME:$NAME" "$HOME_DIR" 2>/dev/null || true

if which tarsila-atalho-criar >/dev/null 2>&1; then
  tarsila-atalho-criar agenda-tarsila 2>/dev/null || true
  tarsila-atalho-criar tarsila-email 2>/dev/null || true
fi

# Sempre remove o modo OOBE, mesmo se algo acima falhou
rm -f /var/lib/tarsila/firstboot /etc/lightdm/lightdm.conf.d/99-tarsila-oobe.conf /etc/sudoers.d/tarsila-oobe
systemctl restart lightdm 2>/dev/null || true