#!/bin/bash
# Grava o estado da maquina a cada 30 s em DISCO REAL.
# Por que nao usar o journal: nesta box /var/log e um overlay em zram (RAM) e o
# zram-config-sync horario PARA o journald (testado: active -> inactive), entao
# o log some justamente quando interessa. Este arquivo fica no eMMC e sobrevive
# a reset do watchdog: a ULTIMA linha diz a que horas a maquina congelou e em
# que estado ela estava.
F=/opt/tarsila-diag/heartbeat.log
G=/sys/class/devfreq/fe400000.gpu
T=/sys/class/thermal/thermal_zone0/temp
n=0
while :; do
    read -r l1 l5 _ < /proc/loadavg
    # Uma unica leitura do /proc/meminfo resolve os tres numeros (antes eram
    # dois awk lendo o mesmo arquivo duas vezes).
    read -r mem swap < <(awk '/MemAvailable/{m=$2/1024} /SwapFree/{f=$2} /SwapTotal/{t=$2} END{printf "%d %d", m, (t-f)/1024}' /proc/meminfo)
    # read builtin no lugar de cat (2 forks a menos por ciclo).
    read -r gpu < "$G/cur_freq" 2>/dev/null || gpu=0
    gpu=$(( gpu / 1000000 ))
    read -r tmp < "$T" 2>/dev/null || tmp=0
    tmp=$(( tmp / 1000 ))
    printf '%s load=%s/%s memdisp=%sMB swap=%sMB gpu=%sMHz temp=%sC xorg=%s chromium=%s\n' \
        "$(date '+%F %T')" "$l1" "$l5" "$mem" "$swap" "$gpu" "$tmp" \
        "$(pgrep -cx Xorg)" "$(pgrep -cx chromium)" >> "$F"
    # teto de ~2000 linhas (~17 h): checar a cada 10 ciclos (5 min) para nao
    # ler o arquivo inteiro a cada 30 s so para contar linhas.
    n=$((n + 1))
    if [ $((n % 10)) -eq 0 ]; then
        if [ "$(wc -l < "$F")" -gt 2000 ]; then tail -n 1500 "$F" > "$F.tmp" && mv "$F.tmp" "$F"; fi
    fi
    sync -f "$F"
    sleep 30
done
