#!/bin/bash
set -euo pipefail
DROPIN=/etc/lightdm/lightdm.conf.d/99-tarsila-oobe.conf

id tarsila-oobe >/dev/null 2>&1 || useradd -r -d /var/lib/tarsila/oobe-home \
  -s /bin/bash -c 'Tarsila OOBE setup' tarsila-oobe
mkdir -p /var/lib/tarsila/oobe-home && chown tarsila-oobe:tarsila-oobe /var/lib/tarsila/oobe-home

mkdir -p /etc/tarsila
STATUS=$(passwd -S root | awk '{print $2}')
RSTATE="ok"
case "$STATUS" in
  NP|L|LK) RSTATE="none" ;;
  P)
    if python3 -c "
import crypt
with open('/etc/shadow') as f:
  for l in f:
    if l.startswith('root:'):
      h = l.split(':')[1]
      if not h or h in ('!','*','!!','x'):
        print('weak')
        break
      for p in ['', 'root', 'toor', 'admin', 'password', '1234', '12345', '123456', '12345678', 'changeme']:
        if crypt.crypt(p, h) == h:
          print('weak')
          break
" 2>/dev/null | grep -q "weak"; then
      RSTATE="weak"
    fi
    ;;
esac
echo "$RSTATE" > /etc/tarsila/oobe-root-state
chmod 644 /etc/tarsila/oobe-root-state

mkdir -p "$(dirname "$DROPIN")"
cat > "$DROPIN" <<'LIGHTDM'
[Seat:*]
autologin-user=tarsila-oobe
autologin-session=tarsila-oobe
LIGHTDM

cat > /etc/sudoers.d/tarsila-oobe <<'SUDOERS'
tarsila-oobe ALL=(root) NOPASSWD: /usr/local/sbin/tarsila-user-provision
SUDOERS
chmod 440 /etc/sudoers.d/tarsila-oobe
visudo -cf /etc/sudoers.d/tarsila-oobe >/dev/null 2>&1 || { rm -f /etc/sudoers.d/tarsila-oobe; echo "ERRO: sudoers da OOBE inválido" >&2; exit 1; }