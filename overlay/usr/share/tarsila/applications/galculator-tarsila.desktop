[Desktop Entry]
Actions=tirar-dock;desinstalar;
StartupNotify=true
Type=Application
Name=Calculadora
Comment=Galculator
Exec=/usr/local/bin/tarsila-abrindo /usr/local/bin/tarsila-uma-janela calc "^Calculadora$" /usr/local/bin/tarsila-calculadora
Icon=galculator
Terminal=false
Categories=Utility;


[Desktop Action tirar-dock]
Name=Tirar do Dock
Exec=/usr/local/bin/tarsila-dock-item.sh remove /usr/share/tarsila/applications/galculator-tarsila.desktop

[Desktop Action desinstalar]
Name=Desinstalar
Exec=/usr/local/bin/tarsila-app-uninstall.sh /usr/share/tarsila/applications/galculator-tarsila.desktop
