[Desktop Entry]
Actions=tirar-dock;desinstalar;
StartupNotify=true
Type=Application
Name=AbiWord
Comment=Editor de texto leve
Exec=abiword %F
Icon=x-office-document
Terminal=false
Categories=Office;WordProcessor;

[Desktop Action tirar-dock]
Name=Tirar do Dock
Exec=/usr/local/bin/tarsila-dock-item.sh remove /usr/share/tarsila/applications/abiword-tarsila.desktop

[Desktop Action desinstalar]
Name=Desinstalar
Exec=/usr/local/bin/tarsila-app-uninstall.sh /usr/share/tarsila/applications/abiword-tarsila.desktop
