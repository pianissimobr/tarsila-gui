[Desktop Entry]
Actions=tirar-dock;desinstalar;
StartupNotify=true
Type=Application
Name=Excel Leve
Comment=Planilhas leves (Gnumeric)
Exec=gnumeric %F
Icon=x-office-spreadsheet
Terminal=false
Categories=Office;Spreadsheet;

[Desktop Action tirar-dock]
Name=Tirar do Dock
Exec=/usr/local/bin/tarsila-dock-item.sh remove /usr/share/tarsila/applications/excel-leve.desktop

[Desktop Action desinstalar]
Name=Desinstalar
Exec=/usr/local/bin/tarsila-app-uninstall.sh /usr/share/tarsila/applications/excel-leve.desktop
