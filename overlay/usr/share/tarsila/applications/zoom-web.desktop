[Desktop Entry]
Actions=tirar-dock;desinstalar;
StartupNotify=true
Type=Application
Name=Zoom
Comment=Zoom Web Client
Exec=/usr/local/bin/tarsila-abrindo chromium --app=https://app.zoom.us/wc/home
Icon=/usr/share/tarsila/icons/zoom.png
Terminal=false
Categories=Network;VideoConference;

[Desktop Action tirar-dock]
Name=Tirar do Dock
Exec=/usr/local/bin/tarsila-dock-item.sh remove /usr/share/tarsila/applications/zoom-web.desktop

[Desktop Action desinstalar]
Name=Desinstalar
Exec=/usr/local/bin/tarsila-app-uninstall.sh /usr/share/tarsila/applications/zoom-web.desktop
