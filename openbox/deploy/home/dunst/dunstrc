[global]
    monitor = 0
    follow = none
    width = 340
    height = 140
    origin = top-center
    offset = 0x46
    scale = 0
    notification_limit = 4
    progress_bar = true
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 10
    horizontal_padding = 12
    frame_width = 1
    frame_color = "#88888844"
    gap_size = 6
    sort = yes
    font = Sans 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    show_indicators = no
    icon_position = left
    max_icon_size = 40
    corner_radius = 8
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#2a2e32"
    foreground = "#e8e8ea"
    timeout = 6

[urgency_normal]
    background = "#194350"
    foreground = "#f2f6f7"
    timeout = 8

[urgency_critical]
    background = "#5a1f1f"
    foreground = "#f7f2f2"
    timeout = 0
