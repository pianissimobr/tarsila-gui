<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance>
    <strength>10</strength>
    <!-- resistência DESLIGADA: a janela pode ser arrastada por cima da
         faixa da barra de cima, que era o pedido.
         Quem decide onde o aplicativo MAXIMIZADO termina continua sendo a
         margem do topo, e ela fica fixa na altura da barra. Alterná-la
         conforme a maximização fazia a janela crescer até o topo e ser
         reajustada logo depois: era desenhada duas vezes, e dava um
         embaralhado visível na barra. -->
    <screen_edge_strength>0</screen_edge_strength>
  </resistance>
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
    <!-- raiseOnFocus: reforço; o clique na área do app usa o binding
         padrão Client Press→Focus+Raise (Openbox encaminha o clique) -->
    <raiseOnFocus>yes</raiseOnFocus>
  </focus>
  <placement>
    <policy>Smart</policy>
    <center>yes</center>
    <monitor>Primary</monitor>
    <primaryMonitor>1</primaryMonitor>
  </placement>
  <theme>
    <name>Tarsila</name>
    <titleLayout>CML</titleLayout>
    <keepBorder>yes</keepBorder>
    <invisibleHandles>yes</invisibleHandles>
    <animateIconify>no</animateIconify>
    <font place="ActiveWindow">
      <name>DejaVu Sans</name>
      <size>11</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="InactiveWindow">
      <name>DejaVu Sans</name>
      <size>11</size>
      <weight>normal</weight>
      <slant>normal</slant>
    </font>
  </theme>
  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>Tarsila</name>
    </names>
    <popupTime>0</popupTime>
  </desktops>
  <resize>
    <drawContents>yes</drawContents>
    <popupShow>Never</popupShow>
  </resize>
  <margins>
    <top>24</top>
  </margins>
  <keyboard>
    <keybind key="A-Tab">
      <action name="NextWindow"><finalactions><action name="Focus"/><action name="Raise"/></finalactions></action>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow"><finalactions><action name="Focus"/><action name="Raise"/></finalactions></action>
    </keybind>
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <!-- usados pelo tarsila-ob-decor.sh p/ tirar/devolver a barra de titulo
         ao maximizar/restaurar (nao sao atalhos p/ o usuario) -->
    <keybind key="W-u"><action name="Undecorate"/></keybind>
    <keybind key="W-i"><action name="Decorate"/></keybind>

    <!-- Foto da tela. O scrot ja vem instalado. A notificacao existe porque
         sem ela o usuario aperta a tecla e nao tem nenhum sinal de que algo
         aconteceu, e nao vai procurar na pasta Imagens por conta propria. -->
    <keybind key="Print">
      <action name="Execute">
        <command>sh -c 'mkdir -p ~/Imagens &amp;&amp; scrot -o ~/Imagens/tela-%Y-%m-%d-%H%M%S.png &amp;&amp; notify-send -a Tarsila -i camera-photo "Foto da tela salva" "Esta na pasta Imagens"'</command>
      </action>
    </keybind>
    <keybind key="A-Print">
      <action name="Execute">
        <command>sh -c 'mkdir -p ~/Imagens &amp;&amp; scrot -u -o ~/Imagens/janela-%Y-%m-%d-%H%M%S.png &amp;&amp; notify-send -a Tarsila -i camera-photo "Foto da janela salva" "Esta na pasta Imagens"'</command>
      </action>
    </keybind>

    <!-- Teclas de volume do teclado/controle. O -l 1.0 impede passar de 100%,
         que na caixinha da TV distorce o som. -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute"><command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0</command></action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute"><command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-</command></action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute"><command>wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle</command></action>
    </keybind>
  </keyboard>
  <mouse>
    <dragThreshold>4</dragThreshold>
    <doubleClickTime>200</doubleClickTime>
    <context name="Titlebar">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Move"/>
      </mousebind>
      <mousebind button="Left" action="Release">
        <action name="Execute"><command>/usr/local/bin/tarsila-clamp-on-release.sh</command></action>
      </mousebind>
      <mousebind button="Left" action="DoubleClick"><action name="Execute"><command>/usr/local/bin/tarsila-goto3.sh</command></action></mousebind>
      <mousebind button="Right" action="Press"><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
    </context>
    <context name="Maximize">
      <mousebind button="Left" action="Click"><action name="Execute"><command>/usr/local/bin/tarsila-goto3.sh</command></action></mousebind>
      <mousebind button="Middle" action="Click"><action name="ToggleMaximizeVert"/></mousebind>
      <mousebind button="Right" action="Click"><action name="ToggleMaximizeHorz"/></mousebind>
    </context>
    <context name="Close">
      <mousebind button="Left" action="Click"><action name="Close"/></mousebind>
    </context>
    <context name="Iconify">
      <mousebind button="Left" action="Click"><action name="Iconify"/></mousebind>
    </context>
    <!-- clique na área do app: foca e traz à frente (padrão Openbox) -->
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <!-- Alt+arrastar move a partir do conteúdo -->
      <mousebind button="A-Left" action="Drag">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Move"/>
      </mousebind>
      <mousebind button="A-Left" action="Release">
        <action name="Execute"><command>/usr/local/bin/tarsila-clamp-on-release.sh</command></action>
      </mousebind>
    </context>
    <!-- sem Press no Frame — isso quebrava o segura-e-arrasta na decoração -->
    <context name="Frame">
      <mousebind button="A-Left" action="Drag">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Move"/>
      </mousebind>
      <mousebind button="A-Left" action="Release">
        <action name="Execute"><command>/usr/local/bin/tarsila-clamp-on-release.sh</command></action>
      </mousebind>
      <mousebind button="A-Right" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <!-- Redimensionar arrastando as BORDAS e CANTOS da janela. A faixa
         agarrável é INVISÍVEL (invisibleHandles=yes no <theme>) e do tamanho
         da borda do tema; o Resize sem <edge> detecta a direção pela posição
         do cursor. -->
    <context name="Top">
      <mousebind button="Left" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="Bottom">
      <mousebind button="Left" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="Left">
      <mousebind button="Left" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="Right">
      <mousebind button="Left" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="TLCorner">
      <mousebind button="Left" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="TRCorner">
      <mousebind button="Left" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="BLCorner">
      <mousebind button="Left" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="BRCorner">
      <mousebind button="Left" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="Desktop">
      <!-- Clique direito na área de trabalho desabilitado (Tarsila) -->
    </context>
    <context name="MoveResize">
      <mousebind button="Left" action="Release">
        <action name="Execute"><command>/usr/local/bin/tarsila-clamp-on-release.sh</command></action>
      </mousebind>
      <mousebind button="A-Left" action="Release">
        <action name="Execute"><command>/usr/local/bin/tarsila-clamp-on-release.sh</command></action>
      </mousebind>
    </context>
  </mouse>
  <menu>
    <file>menu.xml</file>
    <hideDelay>200</hideDelay>
    <submenuShowDelay>100</submenuShowDelay>
  </menu>
  <applications>
    <application class="Plank">
      <decor>no</decor>
      <focus>no</focus>
      <layer>dock</layer>
    </application>
    <application class="Polybar">
      <decor>no</decor>
      <focus>no</focus>
    </application>
    <!-- Redes sociais (Facebook/Instagram/X) abrem em janela tamanho de
         celular; centralizamos p/ não nascerem desproporcionais. O WhatsApp
         (tarsila-rede-whatsapp) é desktop e também fica centralizado. -->
    <application class="tarsila-rede-*">
      <position force="yes">
        <x>center</x>
        <y>center</y>
      </position>
    </application>
  </applications>
</openbox_config>
