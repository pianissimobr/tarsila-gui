#!/bin/sh
# Autostart da sessão Tarsila-Openbox. Sobe os mesmos componentes da
# sessão XFCE que são independentes do ambiente (Plank, devilspie2,
# tarsila-monitor) + os substitutos leves do XFCE (xsettingsd no lugar do
# xfsettingsd, dunst no lugar do xfce4-notifyd, feh/wallpaper-apply no lugar
# do xfdesktop). NAO ha substituto do xfce4-panel: a barra de cima foi
# removida e o que estava nela virou icone da Dock.

# marcador: identifica a sessao Openbox p/ os scripts compartilhados do XFCE
# (guard robusto contra chamadas a xfce4-panel; nao depende de env)
touch "${XDG_RUNTIME_DIR:-/tmp}/tarsila-openbox.session"

# tema GTK/ícones/fonte/cursor
xsettingsd -c "$HOME/.config/xsettingsd/xsettingsd.conf" &

# notificações (a Tarsila Store usa notify-send ao concluir instalação)
dunst &

# agente de autenticação de administrador (polkit)
# lxpolkit era iniciado aqui E de novo no laco de agentes polkit abaixo.
# Ficou so o laco, que e o portatil (tenta gnome/lxde/mate/kde na ordem).

# papel de parede + adaptação à resolução real da TV (o tamanho do ícone da
# Dock sai daqui; a geometria da barra de cima deixou de existir)
# Resolucao preferida do usuario, escolhida na tela de Ajustes.
# TEM de vir ANTES do wallpaper-apply: e ele quem calcula a geometria da barra
# a partir da altura da tela. Se rodasse depois, a barra sairia dimensionada
# para a resolucao errada.
# So aplica se o modo existir na TV ligada agora -- em outra TV, sai calado e
# vale a negociacao automatica por EDID.
/usr/local/bin/tarsila-resolucao-apply.sh

/usr/local/bin/tarsila-wallpaper-apply.sh &

# Dock. O tarsila-dock-apply.sh continua rodando antes: e ele quem mantem a
# lista de .dockitem, que e de onde a Dock le os lancadores e a ordem.
#
# Eram tres linhas ate 17/08/2026: o dock-apply, o "exec plank" e, quatro
# segundos depois, o tarsila-tela-estados desenhando o botao logo acima da
# Dock. O botao vinha atrasado de proposito -- precisava que o Plank ja
# existisse para medir onde a moldura dele tinha ficado, e se pendurava nela
# por Xlib cru. Toda vez que a Dock aparecia ou sumia eram duas janelas, de
# dois processos, se reposicionando em sequencia. Isso se via.
#
# Agora e uma janela so: o botao e parte do mesmo desenho, move junto e nao ha
# o que sincronizar. Ver overlay/usr/local/bin/tarsila-dock.
( /usr/local/bin/tarsila-dock-apply.sh 2>/dev/null; exec /usr/local/bin/tarsila-dock ) &

# Barra de indicadores, canto superior direito: relogio, sistema, limpar, som,
# rede, desligar. Sao os mesmos seis da polybar, na mesma ordem, chamando os
# mesmos programas -- o que mudou foi o custo de descobrir o estado.
#
# A polybar perguntava o tempo todo: sound.sh a cada 3s e net.sh, que roda
# nmcli, a cada 5s. Era o grosso dos 11 forks/s do sistema PARADO. A barra em
# GTK escuta: volume pelo `pactl subscribe` (um processo dormindo) e rede por
# sinal do NetworkManager no D-Bus (zero processo).
#
# Ela NAO reserva espaco de tela (_NET_WM_STRUT). Fica por cima da janela
# maximizada, no canto direito da barra de titulo, que esta vazio porque os
# botoes da janela ficam a esquerda (titleLayout CML). Com strut o Openbox
# reservaria a largura INTEIRA da tela por causa de uma barra de ~290px.
/usr/local/bin/tarsila-barra &

# Aquece o cache de disco do navegador enquanto a area de trabalho sobe. Sem
# isto o Chromium leva ~18s para abrir na primeira vez do dia e ~5s nas
# seguintes -- medido. O programa espera a area de trabalho terminar de subir,
# confere se ha memoria sobrando e faz o trabalho fora da tela.
# O aquecimento saiu daqui em 06/08: agora e o servico
# tarsila-aquecer@<usuario>.service, que roda no arranque do sistema numa
# tela invisivel. Dentro da sessao ele abria janela de verdade na cara do
# usuario (o Gnumeric era o mais visivel).

# regras de janela (workspace lógico 2, unmaximize, exceções) — igual XFCE
# Tamanho das janelas Abrir/Salvar como (chave unica do GTK, valida para
# todos os aplicativos). Conserta no login um valor que tenha sido
# esticado durante o uso.
/usr/local/bin/tarsila-dialogos &

devilspie2 &

# daemon residente: contagem/sons/renice + alimenta o estado do top bar
/usr/local/bin/tarsila-monitor.sh &

# FONTE DE VERDADE DO ESTADO DA TELA (substitui o par polybar-mode.sh +
# title.sh). Responde "ha janela maximizada?" por evento do X e reimpoe a
# politica da Dock a cada troca. Custa zero parado.
/usr/local/bin/tarsila-estado.sh &

# cursor de "carregando" até a sessão montar
/usr/local/bin/tarsila-boot-cursor.sh &

# compositor xrender: cantos arredondados (janelas flutuantes) + Plank
/usr/local/bin/tarsila-ob-picom.sh &
# --- claws-mail-suite (nao editar esta secao) ---
for a in /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 /usr/bin/lxpolkit /usr/lib/mate-polkit/polkit-mate-authentication-agent-1 /usr/lib/*/libexec/polkit-kde-authentication-agent-1; do [ -x "$a" ] && { "$a" & break; }; done
# Area de transferencia. SEM isto, copiar num app e fechar o app PERDE o
# conteudo -- comportamento normal do X11 (a selecao pertence ao processo, some
# com ele) e incompreensivel para quem nao sabe disso.
#
# Ate 17/08 aqui havia "command -v clipit && clipit", com parcellite de reserva.
# Nenhum dos dois estava instalado, e o "command -v" fazia a linha sair calada:
# o sistema passou meses sem gerenciador nenhum sem nunca acusar.
#
# NAO voltar para o clipit: no trixie ele virou pacote de transicao para o
# diodon e arrasta zeitgeist + xapian, um indexador com banco de dados. Nove
# pacotes num aparelho de 2 GB.
#
# Escolhido por teste, medido na box em 17/08 (copiar, matar o dono, colar):
#   autocutsel  2 MB   NAO preservou. descartado
#   gpaste-2   ~9 MB   grava historico mas nao reassume a selecao: o Ctrl+V
#                      simples continua falhando. descartado
#   qlipper    19 MB PSS  reassume de verdade. escolhido
# O custo e real: ~19 MB de PSS numa sessao de ~173 MB. Se aparecer coisa mais
# leve que REASSUMA a selecao, trocar -- o teste esta em docs/CHECKLIST-UX.md.
command -v qlipper >/dev/null 2>&1 && qlipper &
command -v tint2 >/dev/null 2>&1 && tint2 &
# 2026-07-26: REMOVIDO o disparo automatico do assistente de e-mail.
# Ele abria o 'configurar-claws' 4 s apos TODO login enquanto nao houvesse
# conta configurada -- ou seja, sempre, na cara do usuario. Configurar
# e-mail e ato deliberado: agora so pelo icone da Dock.
# (linha antiga guardada em autostart.bak-20260726)

# Nextcloud: monta o WebDAV (gvfs) se ja houver credenciais; sai calado se nao.
# TEM de ficar AQUI e nao em ~/.config/autostart: o autostart XDG NAO roda nesta
# sessao (openbox-autostart exige PyXDG, que nao esta instalado). O sleep da
# tempo de a rede subir antes de tentar montar.
(sleep 5; python3 "$HOME/.local/bin/nc-mount.py") &

# Modo de espera: video em loop com a hora, depois de N minutos parado.
# N vem de ~/.config/tarsila/descanso-minutos (0 desliga). O video vem de
# ~/.config/tarsila/descanso-video. Custo medido: ~85% de 400% de CPU e +2C.
# Para desligar sem editar nada: echo 0 > ~/.config/tarsila/descanso-minutos
/usr/local/bin/tarsila-descanso-vigia &

# Avisa quando um aparelho e conectado (duas etapas: percebido / pronto).
# Roda na sessao do usuario de proposito: assim ja tem o DBUS das notificacoes
# e nao precisa de regra de udev com root.
/usr/local/bin/tarsila-dispositivos &

# Monta pendrive/cartao/HD sozinho ao espetar e abre o gerenciador de arquivos.
# Sem isto nada montava: o udisks2 da a CAPACIDADE de montar, mas quem montava
# automaticamente no XFCE era o thunar-volman, que nao roda nesta sessao. O
# tarsila-dispositivos so avisa (notify-send), nao monta.
udiskie --automount --notify --no-tray --file-manager=thunar &

# Velocidade do ponteiro, repeticao de tecla e teclas de aderencia, como
# escolhidos na tela de Ajustes. O xset aplica mas nao persiste entre sessoes
# e aqui nao ha xfsettingsd para reaplicar -- por isso este script.
# As teclas de aderencia (5x Shift) ficam DESLIGADAS por padrao: ligam sozinhas
# sem querer, deixam o teclado "grudado" e o leigo nao entende o que houve.
(sleep 2; /usr/local/bin/tarsila-entrada-apply.sh) &

