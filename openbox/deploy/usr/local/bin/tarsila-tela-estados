#!/usr/bin/env python3
"""Reage ao estado da tela: com ou sem janela maximizada.

Um processo só, porque as três coisas abaixo dependem da mesma pergunta —
"há alguma janela maximizada?" — e ficar com três vigias custaria caro nesta
máquina.

1. BOTÃO DA DOCK. Encostado no meio da borda de cima da Dock, com o desenho
   de um losango partido ao meio. Clicou, a Dock some e o botão desce para o
   rodapé; clicou de novo, ela volta. A escolha manual é esquecida a cada
   troca de estado: maximizou, some; desmaximizou, aparece.

2. FUNDO DA BARRA DE CIMA. Sem nada maximizado, a barra do sistema fica
   transparente e os ícones flutuam sobre o papel de parede — o retângulo
   claro some. Com algo maximizado, esta janela pinta o fundo sólido atrás
   dela e tudo volta a ser como era. Fazemos assim porque o polybar só lê a
   cor de fundo ao iniciar: trocar a cor exigiria reiniciar a barra a cada
   maximização, e ela piscaria toda vez.

Regra que vale sobre tudo: havendo janela maximizada, é o estado maximizado
que manda, mesmo com outras janelas flutuando na tela.

Sobre o topo da tela: a liberdade de arrastar as janelas por cima da faixa
da barra NÃO é feita aqui. Ela vem de <screen_edge_strength>0 no rc.xml, uma
vez só. A margem do Openbox continua fixa na altura da barra, e isso é de
propósito: ela decide onde o aplicativo maximizado termina. Zerá-la na hora
da maximização fazia a janela crescer até o topo e ser reajustada logo em
seguida -- ela era desenhada duas vezes, e dava um embaralhado visível na
barra.
"""

import math
import os
import re
import subprocess

import cairo
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GdkX11", "3.0")
from gi.repository import Gtk, Gdk, GdkX11, GLib

LARGURA = 46
ALTURA = 20

# Onde o tarsila-title.sh anota se há janela maximizada. É a mesma fonte que
# o devilspie2 e as bolinhas do topo usam -- ler daqui evita perguntar ao X
# de novo a cada segundo.
RT = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
ESTADO_TOPO = os.path.join(RT, "tarsila-topbar-state.txt")

CASA = os.path.expanduser("~")
CFG = os.path.join(CASA, ".config", "tarsila")


def altura_da_barra():
    """Altura real da barra, escrita pelo tarsila-ob-bar.sh."""
    try:
        with open(os.path.join(CFG, "bar-height"), encoding="utf-8") as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return 34


def cor_do_fundo():
    """Cor sólida da barra, escrita pelo tarsila-ob-bar.sh."""
    try:
        with open(os.path.join(CFG, "bar-bg"), encoding="utf-8") as f:
            cor = f.read().strip()
            if cor.startswith("#") and len(cor) in (7, 9):
                return cor
    except OSError:
        pass
    return "#EDF1F4"


class Fundo(Gtk.Window):
    """O retângulo sólido atrás da barra de cima.

    Só aparece quando há janela maximizada. Sem ele, a barra transparente
    deixaria o papel de parede à mostra por cima do aplicativo."""

    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_type_hint(Gdk.WindowTypeHint.DOCK)
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_accept_focus(False)
        self.set_resizable(False)
        self.set_app_paintable(True)
        tela = self.get_screen()
        self.set_size_request(tela.get_width(), altura_da_barra())
        self.connect("draw", self._desenha)

    @staticmethod
    def _desenha(_w, cr):
        cor = Gdk.RGBA()
        cor.parse(cor_do_fundo())
        cr.set_source_rgba(cor.red, cor.green, cor.blue, 1.0)
        cr.paint()
        return False

    def aplicar(self, maximizada):
        if maximizada:
            self.show_all()
            self.move(0, 0)
            # Abaixo da barra, para os ícones continuarem por cima.
            janela = self.get_window()
            if janela is not None:
                janela.lower()
        else:
            self.hide()


def roda(*args):
    try:
        subprocess.run(args, capture_output=True, timeout=4)
    except Exception:
        pass


def estado_da_tela():
    """(há janela maximizada, id da janela ativa)."""
    try:
        with open(ESTADO_TOPO, encoding="utf-8", errors="ignore") as f:
            texto = f.read()
    except OSError:
        return False, None
    ident = None
    for linha in texto.splitlines():
        if linha.startswith("ID="):
            try:
                ident = int(linha[3:].strip())
            except ValueError:
                ident = None
    return ("MAX=1" in texto), ident


def ha_maximizada():
    return estado_da_tela()[0]


class MemoriaDeJanelas:
    """Guarda onde cada janela estava antes de ser maximizada.

    O normal é o gerenciador devolver a janela ao lugar de antes quando ela
    sai do maximizado, e para quase todo aplicativo é o que acontece. Menos
    para os que redimensionam em passos: o terminal cresce de linha em linha,
    e o Openbox erra a conta na volta. Medido aqui: um terminal em 817x485
    voltava com 1357x694 -- praticamente maximizado de novo.

    Então guardamos o quadro enquanto a janela está solta e o repomos quando
    ela sai do maximizado. Vale SÓ para maximizar e desmaximizar: aplicativo
    que abre do zero continua nascendo como o programa manda, sem memória de
    onde esteve da última vez.
    """

    LIMITE = 40      # janelas lembradas; além disso as mais antigas saem

    def __init__(self):
        self.quadros = {}
        self.maximizada = None

    @staticmethod
    def _janela_ativa():
        """Id da janela em foco. O arquivo de estado só traz o id quando há
        maximizada -- fora disso é aqui que descobrimos quem está na frente.
        Consulta ao X, sem abrir processo."""
        Gdk.error_trap_push()
        try:
            ativa = Gdk.Screen.get_default().get_active_window()
            return ativa.get_xid() if ativa is not None else None
        except Exception:
            return None
        finally:
            Gdk.Display.get_default().sync()
            Gdk.error_trap_pop_ignored()

    @staticmethod
    def _quadro(xid):
        """Onde a janela está e de que tamanho, sem abrir processo.

        A posição é a do QUADRO (com a barra de título) e o tamanho é o do
        CONTEÚDO, que é exatamente o par que o wmctrl espera na volta. Guardar
        o tamanho do quadro faria a janela engordar a espessura da moldura a
        cada ida e volta."""
        # A janela pode ter sido fechada entre uma volta e outra. Perguntar
        # por uma janela que nao existe mais gera um erro do X, e erro do X
        # NAO vira excecao em Python: o GDK derruba o processo inteiro. Foi
        # exatamente o que aconteceu -- o programa morria e levava junto o
        # botao da Dock e o fundo da barra. A armadilha abaixo engole isso.
        Gdk.error_trap_push()
        try:
            tela = GdkX11.X11Display.get_default()
            janela = GdkX11.X11Window.foreign_new_for_display(tela, xid)
            if janela is None:
                return None
            moldura = janela.get_frame_extents()
            _, _, largura, altura = janela.get_geometry()
            if largura <= 0 or altura <= 0:
                return None
            return (moldura.x, moldura.y, largura, altura)
        except Exception:
            return None
        finally:
            Gdk.Display.get_default().sync()
            Gdk.error_trap_pop_ignored()

    def acompanhar(self, maximizada, ident):
        if maximizada:
            if ident:
                self.maximizada = ident
            return
        if not ident:
            ident = self._janela_ativa()

        saiu = self.maximizada
        self.maximizada = None
        if saiu is not None:
            guardado = self.quadros.get(saiu)
            if guardado:
                x, y, l, a = guardado
                roda("wmctrl", "-i", "-r", str(saiu),
                     "-e", "0,%d,%d,%d,%d" % (x, y, l, a))
                self.quadros.pop(saiu, None)
                # Nesta volta o quadro na tela ainda é o errado: não guardar.
                return

        if ident:
            atual = self._quadro(ident)
            if atual and not self._parece_maximizada(atual):
                if len(self.quadros) >= self.LIMITE:
                    self.quadros.pop(next(iter(self.quadros)), None)
                self.quadros[ident] = atual

    @staticmethod
    def _parece_maximizada(quadro):
        """A janela ocupa praticamente a tela toda?

        Precisamos disto porque o arquivo de estado demora a anotar a
        maximização: ela acontece sem trocar a janela em foco, e quem escreve
        o arquivo só relê de tempos em tempos. Nesse intervalo a janela já
        está maximizada e o arquivo ainda diz que não -- e nós guardávamos o
        tamanho da tela inteira como se fosse o tamanho solto dela. A volta do
        maximizar então repunha justamente o que se queria desfazer.

        A conta é por proporção da tela, não por número fixo, e é folgada de
        propósito: uma janela que o usuário deixou ocupando quase tudo não
        serve como "lugar de antes" -- e se ela não for lembrada, o pior que
        acontece é o gerenciador cuidar da volta sozinho, como sempre fez.
        """
        _, _, largura, altura = quadro
        try:
            tela = Gdk.Screen.get_default()
            lt, at = tela.get_width(), tela.get_height()
        except Exception:
            return False
        if lt <= 0 or at <= 0:
            return False
        return largura >= lt * 0.92 and altura >= at * 0.85


class Botao(Gtk.Window):
    def __init__(self, fundo):
        self.fundo = fundo
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        # DOCK: o gerenciador trata como parte do painel -- não recebe foco,
        # não entra no Alt+Tab e não é levada para outra área de trabalho
        # pelas regras do devilspie2.
        self.set_type_hint(Gdk.WindowTypeHint.DOCK)
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_accept_focus(False)
        self.set_resizable(False)
        self.set_size_request(LARGURA, ALTURA)
        self.set_app_paintable(True)

        tela = self.get_screen()
        visual = tela.get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)          # cantos arredondados sem moldura

        area = Gtk.DrawingArea()
        area.connect("draw", self._desenha)
        evt = Gtk.EventBox()
        evt.add(area)
        evt.set_events(Gdk.EventMask.BUTTON_PRESS_MASK
                       | Gdk.EventMask.ENTER_NOTIFY_MASK
                       | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        evt.connect("button-press-event", self._clique)
        evt.connect("enter-notify-event", self._entra)
        evt.connect("leave-notify-event", self._sai)
        self.add(evt)

        self.escondida = False      # escolha manual do usuário
        self.destacado = False      # mouse em cima
        self.max_antes = ha_maximizada()
        self.memoria = MemoriaDeJanelas()
        self.plank = self._acha_plank()

        self.show_all()
        self._posiciona()
        # 250ms, não 1s: o fundo da barra precisa acompanhar a maximização
        # de perto, senão dá para ver o papel de parede pela barra
        # transparente no intervalo. Cada volta é a leitura de um arquivo
        # pequeno -- sem processo novo, sem consulta ao X.
        GLib.timeout_add(250, self._vigia)

    # ---------------------------------------------------------- desenho
    def _desenha(self, area, cr):
        l = area.get_allocated_width()
        a = area.get_allocated_height()
        pi = math.pi

        cr.set_operator(cairo.OPERATOR_SOURCE)   # fundo mesmo transparente
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        # Aba escura no mesmo tom da Dock: cantos arredondados só em cima,
        # porque a base encosta na Dock e as duas formam uma peça só.
        r = 6.0
        cr.new_sub_path()
        cr.arc(l - r, r, r, -pi / 2, 0)          # canto superior direito
        cr.line_to(l, a)
        cr.line_to(0, a)
        cr.arc(r, r, r, pi, 3 * pi / 2)          # canto superior esquerdo
        cr.close_path()
        # Com janela maximizada quem manda e a regra principal e o botao
        # nao tem o que fazer. Em vez de nao responder ao clique sem dizer
        # nada -- o que passa impressao de defeito --, ele fica apagado.
        inerte = ha_maximizada()
        opaco = 0.45 if inerte else (1.0 if self.destacado else 0.94)
        cr.set_source_rgba(0.09, 0.13, 0.25, opaco)
        cr.fill()

        # O símbolo: um losango partido ao meio -- "v" invertido em cima,
        # "v" embaixo, com uma fresta entre eles. Serve para os dois
        # sentidos, então não muda quando a Dock some.
        cr.set_source_rgba(1, 1, 1, 0.45 if inerte else 0.95)
        cr.set_line_width(1.7)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)

        mx = l / 2.0
        braco = 5.5              # metade da largura de cada "v"
        altura_v = 3.6           # o quanto cada "v" sobe ou desce
        folga = 2.2              # fresta entre as duas metades

        meio = a / 2.0
        # metade de cima: ^
        cr.move_to(mx - braco, meio - folga)
        cr.line_to(mx, meio - folga - altura_v)
        cr.line_to(mx + braco, meio - folga)
        cr.stroke()
        # metade de baixo: v
        cr.move_to(mx - braco, meio + folga)
        cr.line_to(mx, meio + folga + altura_v)
        cr.line_to(mx + braco, meio + folga)
        cr.stroke()
        return False

    # -------------------------------------------------------- posição
    def _acha_plank(self):
        """A janela da Dock -- a MAIOR entre as do Plank.

        O Plank tem mais de uma janela no X, e a busca devolve todas. Pegar a
        última dava a janela errada de vez em quando, e o botão ia parar no
        meio da tela. A Dock é, de longe, a mais larga."""
        try:
            r = subprocess.run(["xdotool", "search", "--class", "plank"],
                               capture_output=True, text=True, timeout=5)
            ids = r.stdout.split()
        except Exception:
            return None
        melhor, maior = None, 0
        for xid in ids:
            quadro = MemoriaDeJanelas._quadro(int(xid))
            if not quadro:
                continue
            area = quadro[2] * quadro[3]
            if area > maior:
                melhor, maior = xid, area
        return melhor or (ids[-1] if ids else None)

    def _topo_da_dock(self):
        """Y da borda de cima da Dock, medido -- nada de número fixo."""
        if not self.plank:
            self.plank = self._acha_plank()
        if not self.plank:
            return None
        topo = self._medir(self.plank)
        if topo is None:
            # A Dock pode ter acabado de ser remapeada e a medida vir crua.
            # Refaz a busca uma vez antes de desistir.
            self.plank = self._acha_plank()
            topo = self._medir(self.plank) if self.plank else None
        return topo

    @staticmethod
    def _medir(xid):
        """Y da Dock, se a medida fizer sentido.

        A Dock vive encostada embaixo. Uma leitura que a coloque na metade de
        cima da tela é lixo -- acontecia logo depois de ela ser remapeada, e
        jogava o botão para o alto da tela."""
        quadro = MemoriaDeJanelas._quadro(int(xid))
        if not quadro:
            return None
        y = quadro[1]
        try:
            altura_tela = Gdk.Screen.get_default().get_height()
        except Exception:
            return y
        return y if y > altura_tela / 2 else None

    def _posiciona(self):
        tela = self.get_screen()
        largura_tela = tela.get_width()
        altura_tela = tela.get_height()
        x = (largura_tela - LARGURA) // 2

        if self._dock_na_tela():
            topo = self._topo_da_dock()
            y = (topo - ALTURA) if topo is not None else (altura_tela - ALTURA)
        else:
            # Encostado no rodapé, como o usuário pediu.
            y = altura_tela - ALTURA

        self.move(x, max(0, y))
        self._acima_da_dock()

    def _acima_da_dock(self):
        """Mantém o botão à frente da Dock.

        No rodapé o botão ocupa a mesma faixa da janela do Plank, e o Plank
        fica acima dele na pilha do gerenciador. Enquanto a Dock está
        escondida não se nota; mas basta ela reaparecer -- pelo empurrão do
        mouse na borda de baixo -- para o botão ficar coberto e parecer que
        sumiu. Subir na pilha resolve, e é uma chamada barata: sem processo
        novo."""
        janela = self.get_window()
        if janela is not None:
            janela.raise_()

    def _dock_na_tela(self):
        """A Dock está aparecendo? A regra principal manda; a escolha
        manual só vale quando não há janela maximizada."""
        if ha_maximizada():
            return False
        return not self.escondida

    # --------------------------------------------------------- eventos
    def _clique(self, _w, ev):
        if ev.button != 1:
            return False
        if ha_maximizada():
            # Regra principal no comando: nada a fazer aqui.
            return True
        self.escondida = not self.escondida
        self._aplica()
        return True

    def _aplica(self):
        # Reconsulta sempre: se a Dock foi reiniciada (troca de tema, ajuste
        # no Gerenciar Dock), o identificador guardado aponta para uma janela
        # que não existe mais e o clique não faria nada. Clique é raro, então
        # a consulta não pesa.
        self.plank = self._acha_plank()
        if self.plank:
            roda("xdotool",
                 "windowunmap" if self.escondida else "windowmap", self.plank)
        self._posiciona()
        self.queue_draw()

    def _entra(self, *_a):
        self.destacado = True
        self.queue_draw()
        return False

    def _sai(self, *_a):
        self.destacado = False
        self.queue_draw()
        return False

    # ---------------------------------------------------------- vigia
    def _vigia(self):
        maximizada, ident = estado_da_tela()
        self.memoria.acompanhar(maximizada, ident)
        # No rodapé o botão divide a faixa com a Dock: reafirmar a frente a
        # cada volta cobre o caso de ela reaparecer por conta própria.
        if not self._dock_na_tela():
            self._acima_da_dock()
        agora = ha_maximizada()
        if agora != self.max_antes:
            # Trocou de estado: a escolha manual é esquecida. Maximizou, some;
            # desmaximizou, aparece -- não importa o que o botão fez antes.
            self.max_antes = agora
            self.fundo.aplicar(agora)
            if self.escondida:
                self.escondida = False
                self._aplica()
            else:
                self._posiciona()
            self.queue_draw()      # muda o tom: ativo <-> apagado
        return True


def main():
    fundo = Fundo()
    botao = Botao(fundo)
    # Estado de partida: a sessão pode nascer com algo já maximizado.
    agora = ha_maximizada()
    fundo.aplicar(agora)
    botao.max_antes = agora
    Gtk.main()


if __name__ == "__main__":
    main()
