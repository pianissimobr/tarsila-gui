#!/bin/bash
# Tamanho e lugar das janelas "Abrir" e "Salvar como" -- de todos os
# aplicativos GTK3 de uma vez.
#
# O GTK guarda esse tamanho numa unica chave por usuario
# (org.gtk.Settings.FileChooser), compartilhada por AbiWord, Gnumeric,
# Thunar, Xarchiver, Galculator e companhia. E ele REGRAVA a chave toda vez
# que a janela e fechada. Basta alguem esticar o dialogo uma vez para que
# TODOS os aplicativos passem a abrir aquele tamanho, para sempre. Foi o que
# aconteceu aqui: a chave estava em 1332 de largura numa tela de 1366 -- 97%
# da tela para escolher um nome de arquivo.
#
# Rodando no arranque da sessao, um valor estragado se conserta sozinho no
# proximo login, sem tirar do usuario a liberdade de redimensionar durante o
# uso.
#
# Nada aqui e medida fixa: tudo sai da resolucao que a tela tiver.

set -uo pipefail
command -v gsettings >/dev/null 2>&1 || exit 0

# Proporcoes de uma janela de dialogo confortavel: larga o bastante para a
# lista de arquivos, baixa o bastante para sobrar tela em volta.
LARGURA_PCT=60
ALTURA_PCT=70

geo=$(xdotool getdisplaygeometry 2>/dev/null) || exit 0
sw=${geo%% *}; sh=${geo##* }
[ -n "$sw" ] && [ -n "$sh" ] && [ "$sw" -gt 0 ] 2>/dev/null || exit 0

gsettings set org.gtk.Settings.FileChooser window-size \
    "($(( sw * LARGURA_PCT / 100 )), $(( sh * ALTURA_PCT / 100 )))" 2>/dev/null

# (-1, -1) quer dizer "nao lembre de canto nenhum": quem escolhe onde por e
# o gerenciador de janelas, que ja esta configurado para centralizar.
gsettings set org.gtk.Settings.FileChooser window-position "(-1, -1)" 2>/dev/null
