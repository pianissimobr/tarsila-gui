#!/bin/bash
# Aquece o cache de disco do navegador durante a inicialização.
#
# POR QUE ISTO EXISTE
#
# Medido nesta tvbox: o Chromium leva 19s para abrir com o cache frio e 5s com
# o cache quente. A diferença não é do Chromium -- é do Linux. Ele não carrega
# o programa inteiro de uma vez: mapeia o executável e as bibliotecas e vai
# buscando no disco cada pedaço que falta. Cada busca dessas é uma "falta de
# página maior", e na primeira abertura foram 2.561 delas contra 17 na
# segunda. Depois que o processo morre, as páginas ficam na memória (o page
# cache do sistema) e a abertura seguinte quase não toca no disco.
#
# Abrir e fechar o navegador aqui deixa exatamente essas páginas prontas.
#
# POR QUE NA INICIALIZAÇÃO, E NÃO DEPOIS
#
# Esses 19s existem de um jeito ou de outro; a escolha é onde gastá-los.
# Esperar enquanto o sistema liga é tempo que a pessoa já contava; esperar
# depois de clicar no navegador vira "esse sistema é lento". Decisão do dono
# do projeto, e é a leitura certa de expectativa.
#
# CUSTO
#
# São ~286 MB de page cache. Isso NÃO é memória usada: o núcleo devolve essas
# páginas na hora em que qualquer programa precisar. Medido: com 410 MB de
# cache a mais, a memória disponível caiu de 1430 MB para 1426 MB. Ainda
# assim só aquecemos se houver folga -- ver a conta abaixo.

set -uo pipefail

NAVEGADOR=chromium
PERFIL="${XDG_RUNTIME_DIR:-/tmp}/tarsila-aquecimento"
# O registro vai para a pasta do usuario: /opt/tarsila-diag pertence ao root
# e este programa roda na sessao dele.
REGISTRO="${XDG_DATA_HOME:-$HOME/.local/share}/tarsila/aquecimento.log"

# A folga é uma PROPORÇÃO da memória da máquina, não um número fixo: este
# sistema vai para outras tvboxes, com mais ou menos RAM, e um "350 MB"
# escrito aqui estaria errado em todas as outras.
FOLGA_MINIMA=55        # % da memória total que precisa estar disponível

anotar() {
    mkdir -p "$(dirname "$REGISTRO")" 2>/dev/null
    printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$REGISTRO" 2>/dev/null
}

campo() { awk -v c="$1" '$1==c":" {print $2; exit}' /proc/meminfo; }

command -v "$NAVEGADOR" >/dev/null 2>&1 || exit 0
command -v xdotool     >/dev/null 2>&1 || exit 0

# Deixa a área de trabalho terminar de subir antes de disputar o disco com
# ela. Sem isto o aquecimento atrasaria justamente o que o usuário está
# esperando ver.
sleep 20

# Se o usuário já abriu o navegador, não há o que aquecer.
pgrep -x "$NAVEGADOR" >/dev/null 2>&1 && { anotar "ja aberto, nada a fazer"; exit 0; }

total=$(campo MemTotal)
livre=$(campo MemAvailable)
[ -n "$total" ] && [ -n "$livre" ] && [ "$total" -gt 0 ] 2>/dev/null || exit 0
proporcao=$(( livre * 100 / total ))
if [ "$proporcao" -lt "$FOLGA_MINIMA" ]; then
    anotar "sem folga: $proporcao% disponivel (minimo $FOLGA_MINIMA%) -- nao aqueceu"
    exit 0
fi

# --class: o devilspie2 maximiza e tira a decoração de toda janela "Chromium".
#   Com uma classe própria ele não encosta nesta.
# --window-position bem fora da tela: o usuário não vê nada acontecer.
# --user-data-dir próprio: sem isto, se o usuário abrisse o navegador no meio
#   do aquecimento, a janela dele grudaria nesta instância -- fora da tela e
#   sem decoração.
inicio=$(date +%s)
ionice -c3 nice -n 19 setsid "$NAVEGADOR" \
    --class=Tarsila-aquecimento \
    --user-data-dir="$PERFIL" \
    --window-position=-32000,-32000 --window-size=400,300 \
    --no-first-run --no-default-browser-check \
    --disable-session-crashed-bubble --hide-crash-restore-bubble \
    about:blank >/dev/null 2>&1 &

# Espera a janela existir: é o sinal de que as bibliotecas já foram lidas.
pronto=0
for _ in $(seq 1 120); do
    if xdotool search --class "Tarsila-aquecimento" >/dev/null 2>&1; then
        pronto=1
        break
    fi
    sleep 0.5
done
[ "$pronto" = 1 ] && sleep 3      # deixa terminar de carregar o que falta

# Mata pelo caminho do perfil temporario: pega o processo principal e os
# auxiliares, e nunca encosta num Chromium que o usuario tenha aberto.
pkill -f "tarsila-aquecimento" 2>/dev/null
# O Chromium leva alguns segundos para os processos auxiliares sairem.
for _ in $(seq 1 20); do
    pgrep -f "tarsila-aquecimento" >/dev/null 2>&1 || break
    sleep 0.5
done
pkill -9 -f "tarsila-aquecimento" 2>/dev/null
rm -rf "$PERFIL" 2>/dev/null

anotar "aquecido em $(( $(date +%s) - inicio ))s (disponivel: $proporcao%)"
