# Tarsila — tema Openbox. Barra de titulo cinza clara e plana, que quase
# funde com a janela. Fonte e layout dos botoes vem do rc.xml.

# --- bordas ---
border.width: 1
# A borda era quase branca (#dbdfe3 / #e9ecee) e sumia: sobre o papel de
# parede claro, ou com duas janelas encostadas, nao dava para ver onde uma
# terminava e a outra comecava. Agora e um cinza que marca o contorno sem
# virar moldura -- a janela em foco um pouco mais escura que as outras, para
# se distinguir delas.
window.active.border.color: #8b959d
window.inactive.border.color: #b9c0c6

# --- barra de titulo (cinza claro sutil) ---
padding.width: 8
padding.height: 6
window.label.text.justify: left

window.active.title.bg: flat solid
window.active.title.bg.color: #e7eaed
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #eef1f3

window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: #2a2e32
window.inactive.label.text.color: #8b9298

window.active.title.separator.color: #d3d8dc
window.inactive.title.separator.color: #e2e6e9

# --- sem handle inferior ---
window.handle.width: 3
window.active.handle.bg: flat solid
window.active.handle.bg.color: #c7ccd1
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #dbdfe3
window.active.grip.bg: flat solid
window.inactive.grip.bg: flat solid
window.client.padding.width: 3
window.inactive.client.color: #dbdfe3
window.active.client.color: #c7ccd1
window.client.padding.height: 0

# --- botoes planos e discretos ---
window.active.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.bg: parentrelative
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #d7dbdf
window.inactive.button.hover.bg: parentrelative
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #cfd4d8

window.active.button.unpressed.image.color: #3a3e42
window.inactive.button.unpressed.image.color: #9aa0a6
window.active.button.hover.image.color: #000000
window.active.button.pressed.image.color: #000000
window.active.button.disabled.image.color: #c9ced2

# fechar e maximizar: bolinha cheia (close.xbm/max.xbm, ao lado deste
# arquivo, 12x12 -- subiu de 10x10 em 23/08/2026 a pedido), cor de
# referencia do macOS (#FF605C / #00CA4E), escurecendo ~28% no hover.
# Sem preencher o fundo.
#
# O desenho original (circulo com o X/setas recortados por dentro, pedido
# junto) nao sobrevive: o botao de verdade tem so uns 10-12px, e nesse
# tamanho o recorte vira ruido em vez de forma -- testado ao vivo em 12, 16,
# 20 e 24px antes de desistir dele. A bolinha cheia e o que sobra legivel.
window.active.button.close.unpressed.image.color: #FF605C
window.active.button.close.hover.bg: parentrelative
window.active.button.close.hover.image.color: #B74542

window.active.button.max.unpressed.image.color: #00CA4E
window.active.button.max.hover.bg: parentrelative
window.active.button.max.hover.image.color: #009138

# janela ja maximizada: o botao vira "restaurar" e o Openbox troca para o
# estado ".toggled", que sem isto cai na cor cinza padrao dos outros botoes.
window.active.button.max.toggled.unpressed.image.color: #00CA4E
window.active.button.max.toggled.hover.bg: parentrelative
window.active.button.max.toggled.hover.image.color: #009138

# --- menus ---
menu.border.width: 1
menu.border.color: #c7ccd1
menu.title.bg: flat solid
menu.title.bg.color: #e7eaed
menu.title.text.color: #2a2e32
menu.title.text.justify: left
menu.items.bg: flat solid
menu.items.bg.color: #ffffff
menu.items.text.color: #2a2e32
menu.items.active.bg: flat solid
menu.items.active.bg.color: #3b6ea5
menu.items.active.text.color: #ffffff
menu.separator.color: #e2e6e9

# --- osd ---
osd.border.width: 1
osd.border.color: #c7ccd1
osd.bg: flat solid
osd.bg.color: #e7eaed
osd.label.text.color: #2a2e32
window.active.grip.bg.color: #c7ccd1
window.inactive.grip.bg.color: #dbdfe3
