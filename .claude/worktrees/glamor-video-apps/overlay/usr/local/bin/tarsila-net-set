#!/bin/bash
# Aplica configuracao IPv4 numa conexao do NetworkManager, sem depender
# do polkit (nm-connection-editor exige um agente grafico que este
# sistema nao tem para XFCE). Chamado pelo painel via "sudo -n".
#
# Uso:
#   tarsila-net-set <conexao> auto
#   tarsila-net-set <conexao> manual <ip/prefixo> <gateway> <dns>
set -euo pipefail

conn="$1"
method="$2"

case "$method" in
  auto)
    nmcli connection modify "$conn" \
      ipv4.method auto ipv4.addresses "" ipv4.gateway "" ipv4.dns ""
    ;;
  manual)
    ip="$3"; gw="$4"; dns="$5"
    nmcli connection modify "$conn" \
      ipv4.method manual ipv4.addresses "$ip" ipv4.gateway "$gw" ipv4.dns "$dns"
    ;;
  *)
    echo "metodo invalido: $method (use 'auto' ou 'manual')" >&2
    exit 1
    ;;
esac

nmcli connection up "$conn"
