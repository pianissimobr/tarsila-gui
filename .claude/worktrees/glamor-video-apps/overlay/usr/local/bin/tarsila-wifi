#!/usr/bin/env python3
# Tarsila — janela "Conexões de rede" (seção Wi-Fi).
# Tabela: Nome | Sinal | Segurança | Internet.
#  - sem redes            -> "Nenhuma rede disponível" (cor clara)
#  - conectado sem net    -> nome + "Conectado sem internet" (cor clara)
#  - conectado com net    -> "Conectado na Internet · <taxa>" (taxa = velocidade
#                            NEGOCIADA do link, lida do NM; não faz teste de
#                            banda, então não custa RAM/CPU/dados)
# O estado de internet vem de `nmcli -t -f CONNECTIVITY general` — o próprio
# NetworkManager já monitora isso, custo zero para nós.
import subprocess, threading
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib, Pango

DIM = '#8a9098'   # cor clara p/ textos secundários


def run(argv, timeout=12):
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        return p.returncode == 0, p.stdout, p.stderr
    except Exception as e:
        return False, '', str(e)


def wifi_device():
    ok, out, _ = run(['nmcli', '-t', '-f', 'DEVICE,TYPE,STATE', 'device', 'status'])
    if ok:
        for line in out.splitlines():
            p = line.split(':')
            if len(p) >= 3 and p[1] == 'wifi':
                return p[0], p[2]
    return None, None


def connectivity():
    ok, out, _ = run(['nmcli', '-t', '-f', 'CONNECTIVITY', 'general', 'status'], 8)
    return out.strip().lower() if ok else 'unknown'


def link_rate(dev):
    """Velocidade negociada do link (grátis — não é teste de banda)."""
    if not dev:
        return ''
    ok, out, _ = run(['nmcli', '-t', '-f', 'GENERAL.SPEED', 'device', 'show', dev], 8)
    if ok and out.strip():
        v = out.split(':', 1)[-1].strip()
        if v and v not in ('unknown', '0 Mb/s', '0'):
            return v
    return ''


def scan_list():
    ok, out, _ = run(['nmcli', '-t', '-f', 'IN-USE,SSID,SIGNAL,SECURITY',
                      'device', 'wifi', 'list'], 20)
    redes, vistos = [], set()
    if not ok:
        return redes
    for line in out.splitlines():
        p = line.split(':')
        if len(p) < 4:
            continue
        inuse, ssid, sig, sec = p[0], p[1], p[2], ':'.join(p[3:])
        if not ssid or ssid in vistos:
            continue
        vistos.add(ssid)
        try:
            sig = int(sig)
        except ValueError:
            sig = 0
        redes.append({'inuse': inuse.strip() == '*', 'ssid': ssid, 'signal': sig,
                      'sec': sec.strip(), 'aberta': (not sec.strip() or sec.strip() == '--')})
    redes.sort(key=lambda r: (not r['inuse'], -r['signal']))
    return redes


class Conexoes(Gtk.Window):
    def __init__(self):
        super().__init__(title='Conexões de rede')
        self.set_default_size(720, 480)
        self.set_position(Gtk.WindowPosition.CENTER)
        try:
            self.set_wmclass('tarsila-wifi', 'Tarsila-wifi')
        except Exception:
            pass

        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(v)

        tb = Gtk.Box(spacing=8); tb.set_border_width(10)
        t = Gtk.Label(); t.set_markup('<b>Wi-Fi</b>'); t.set_xalign(0)
        tb.pack_start(t, True, True, 0)
        self.btn_scan = Gtk.Button.new_with_label('Procurar redes')
        self.btn_scan.connect('clicked', lambda *_: self.rescan())
        tb.pack_start(self.btn_scan, False, False, 0)
        v.pack_start(tb, False, False, 0)
        v.pack_start(Gtk.Separator(), False, False, 0)

        self.status = Gtk.Label(); self.status.set_xalign(0)
        self.status.set_margin_start(12); self.status.set_margin_top(6)
        v.pack_start(self.status, False, False, 0)

        # tabela
        self.store = Gtk.ListStore(str, str, str, str, str, bool, int)
        # 0 nome, 1 sinal, 2 seguranca, 3 internet, 4 cor-do-nome, 5 conectada, 6 signal%
        self.tree = Gtk.TreeView(model=self.store)
        self.tree.set_headers_visible(True)

        def col(titulo, idx, cor_idx=None, expand=False):
            r = Gtk.CellRendererText()
            r.set_property('ellipsize', Pango.EllipsizeMode.END)
            c = Gtk.TreeViewColumn(titulo, r, text=idx)
            if cor_idx is not None:
                c.add_attribute(r, 'foreground', cor_idx)
            c.set_expand(expand)
            self.tree.append_column(c)

        col('Nome', 0, 4, True)
        col('Sinal', 1)
        col('Segurança', 2)
        col('Internet', 3, 4, True)

        sc = Gtk.ScrolledWindow(); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.add(self.tree)
        v.pack_start(sc, True, True, 0)

        bb = Gtk.Box(spacing=8); bb.set_border_width(10); bb.set_halign(Gtk.Align.END)
        self.btn_disc = Gtk.Button.new_with_label('Desconectar')
        self.btn_disc.connect('clicked', lambda *_: self.desconectar())
        bb.pack_start(self.btn_disc, False, False, 0)
        self.btn_conn = Gtk.Button.new_with_label('Conectar')
        self.btn_conn.get_style_context().add_class('suggested-action')
        self.btn_conn.connect('clicked', lambda *_: self.conectar_sel())
        bb.pack_start(self.btn_conn, False, False, 0)
        v.pack_start(bb, False, False, 0)

        self.tree.connect('row-activated', lambda *_: self.conectar_sel())
        self.show_all()
        self.recarregar()

    # ---------- dados ----------
    def recarregar(self):
        self.status.set_markup('<i>Verificando redes…</i>')
        threading.Thread(target=self._bg, daemon=True).start()

    def _bg(self):
        dev, estado = wifi_device()
        redes = scan_list() if dev else []
        conn = connectivity()
        rate = link_rate(dev) if estado == 'connected' else ''
        GLib.idle_add(self._render, dev, estado, redes, conn, rate)

    def _render(self, dev, estado, redes, conn, rate):
        self.store.clear()
        if not dev:
            self.status.set_markup(
                '<span foreground="%s">Nenhuma placa de Wi-Fi reconhecida neste computador.</span>' % DIM)
            self.btn_scan.set_sensitive(False)
            self.btn_conn.set_sensitive(False)
            self.btn_disc.set_sensitive(False)
            return
        self.btn_scan.set_sensitive(True)
        if not redes:
            self.status.set_markup('<span foreground="%s">Nenhuma rede disponível</span>' % DIM)
            self.btn_conn.set_sensitive(False)
            self.btn_disc.set_sensitive(estado == 'connected')
            return
        self.status.set_text('')
        tem_net = (conn == 'full')
        for r in redes:
            if r['inuse']:
                if tem_net:
                    txt = 'Conectado na Internet' + (' · %s' % rate if rate else '')
                    cor = None
                else:
                    txt = 'Conectado sem internet'
                    cor = DIM
            else:
                txt = ''
                cor = None
            self.store.append([r['ssid'], '%d%%' % r['signal'],
                               'Aberta' if r['aberta'] else 'Senha',
                               txt, cor or '#000000', r['inuse'], r['signal']])
        self.btn_conn.set_sensitive(True)
        self.btn_disc.set_sensitive(estado == 'connected')
        return False

    def rescan(self):
        self.status.set_markup('<i>Procurando redes…</i>')
        def go():
            run(['nmcli', 'device', 'wifi', 'rescan'], 25)
            GLib.idle_add(self.recarregar)
        threading.Thread(target=go, daemon=True).start()

    # ---------- ações ----------
    def _sel(self):
        m, it = self.tree.get_selection().get_selected()
        return (m[it][0], m[it][2] == 'Aberta', m[it][5]) if it else (None, False, False)

    def conectar_sel(self):
        ssid, aberta, conectada = self._sel()
        if not ssid:
            self._msg('Escolha uma rede na lista.', Gtk.MessageType.INFO); return
        if conectada:
            self._msg('Você já está conectado a %s.' % ssid, Gtk.MessageType.INFO); return
        senha = ''
        if not aberta:
            senha = self._pedir_senha(ssid)
            if senha is None:
                return
        cmd = ['nmcli', 'device', 'wifi', 'connect', ssid]
        if senha:
            cmd += ['password', senha]
        ok, out, err = run(cmd, 45)
        self._msg('Conectado a %s.' % ssid if ok else
                  'Não consegui conectar.\n\n%s' % (err or out).strip()[:300],
                  Gtk.MessageType.INFO if ok else Gtk.MessageType.ERROR)
        self.recarregar()

    def desconectar(self):
        dev, _ = wifi_device()
        if dev:
            run(['nmcli', 'device', 'disconnect', dev], 25)
        self.recarregar()

    def _pedir_senha(self, ssid):
        d = Gtk.Dialog(title='Conectar ao Wi-Fi', transient_for=self, modal=True)
        d.add_buttons('Cancelar', Gtk.ResponseType.CANCEL, 'Conectar', Gtk.ResponseType.OK)
        d.set_default_response(Gtk.ResponseType.OK)
        c = d.get_content_area(); c.set_spacing(10)
        for m in ('set_margin_start', 'set_margin_end', 'set_margin_top', 'set_margin_bottom'):
            getattr(c, m)(16)
        l = Gtk.Label(xalign=0)
        l.set_markup('Digite a senha da rede <b>%s</b>:' % GLib.markup_escape_text(ssid))
        c.pack_start(l, False, False, 0)
        e = Gtk.Entry(); e.set_visibility(False); e.set_activates_default(True)
        e.set_placeholder_text('Senha do Wi-Fi')
        c.pack_start(e, False, False, 0)
        cb = Gtk.CheckButton(label='Mostrar senha')
        cb.connect('toggled', lambda b: e.set_visibility(b.get_active()))
        c.pack_start(cb, False, False, 0)
        d.show_all()
        r = d.run(); s = e.get_text(); d.destroy()
        return s if (r == Gtk.ResponseType.OK and s) else None

    def _msg(self, texto, tipo):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=tipo,
                              buttons=Gtk.ButtonsType.OK, text=texto)
        d.run(); d.destroy()


if __name__ == '__main__':
    w = Conexoes()
    w.connect('destroy', Gtk.main_quit)
    Gtk.main()
