#!/usr/bin/env python3
"""Grava as mensagens do KERNEL em disco real, com fsync.

Por que existe: nesta box o journal e volatil (/var/log e zram) e o
zram-config-sync horario ainda PARA o journald. Nos tres travamentos com reset
pelo watchdog nao sobrou uma linha do kernel. Sem isso nao da para saber se a
GPU (panfrost) falhou antes de congelar.

O fsync e por mensagem: reset do watchdog e ABRUPTO, nao ha desligamento nem
flush. Mensagens de kernel sao raras em regime normal, entao o custo e baixo;
em tempestade de faltas, limitamos a 1 fsync por segundo.
"""
import os, time

ALVO = "/opt/tarsila-diag/kmsg.log"
TETO = 4 * 1024 * 1024          # 4 MB, entao rotaciona

os.makedirs(os.path.dirname(ALVO), exist_ok=True)

def girar():
    try:
        if os.path.getsize(ALVO) > TETO:
            os.replace(ALVO, ALVO + ".1")
    except FileNotFoundError:
        pass

girar()
# ARMADILHA: /dev/kmsg entrega UM REGISTRO INTEIRO por read(). readline()
# do Python le byte a byte e PERDE registros (o arquivo saia vazio). Tem de
# usar os.read() direto no descritor.
fd = os.open("/dev/kmsg", os.O_RDONLY)
try:
    os.lseek(fd, 0, os.SEEK_END)    # so o que vier de agora em diante
except OSError:
    pass

saida = open(ALVO, "a", buffering=1, errors="replace")
ultimo_fsync = 0.0
while True:
    try:
        dados = os.read(fd, 8192)
    except BlockingIOError:
        time.sleep(0.2); continue
    except OSError:
        time.sleep(0.5); continue
    if not dados:
        time.sleep(0.2); continue
    texto = dados.decode("utf-8", "replace").rstrip("\n")
    saida.write("%s %s\n" % (time.strftime("%F %T"), texto))
    agora = time.time()
    if agora - ultimo_fsync >= 1.0:
        try:
            saida.flush(); os.fsync(saida.fileno())
        except Exception:
            pass
        ultimo_fsync = agora
