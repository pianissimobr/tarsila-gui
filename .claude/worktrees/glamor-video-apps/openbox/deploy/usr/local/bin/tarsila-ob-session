#!/bin/bash
# Sessão Tarsila leve (Openbox + polybar). COEXISTE com o XFCE: é uma
# entrada de sessão separada no lightdm, escolhível sem afetar a sessão
# XFCE existente. Só define o ambiente e entrega o controle ao
# openbox-session, que roda ~/.config/openbox/autostart (onde os
# componentes da Tarsila sobem).
export XDG_CURRENT_DESKTOP=Openbox
export XDG_SESSION_TYPE=x11
export XDG_SESSION_DESKTOP=tarsila-openbox
# GTK/Qt pegam tema/ícones via xsettingsd (subido no autostart)
exec openbox-session
