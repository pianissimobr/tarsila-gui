-- devilspie2: toda janela nova cai na janela de trabalho 2. Por padrao
-- nunca minimizada, nunca escondida atras do "mostrar area de trabalho",
-- nunca maximizada - excecao: o Chromium sempre abre maximizado (pedido
-- explicito do usuario, unico app com essa excecao).
--
-- GUARDA CRITICA: janelas de shell/sistema (area de trabalho, painel,
-- dock) NUNCA podem ser tocadas por este script. Elas tambem disparam
-- "window_open" quando (re)criadas (ex: reiniciar o xfdesktop), e sem
-- essa guarda o resto do script tenta trocar workspace/maximizar/
-- reposicionar essas janelas como se fossem um app comum - foi
-- exatamente isso que deslocou o xfdesktop da tela (0,0) para uma
-- posicao de cascata, deixando faixas pretas onde devia estar o papel
-- de parede. Comparado por WM_CLASS (classe, nao instancia).
local SYSTEM_CLASSES = { Xfdesktop = true, ["Xfce4-panel"] = true, Plank = true }
if SYSTEM_CLASSES[get_window_class()] then
  return
end

os.execute("/usr/local/bin/tarsila-goto2.sh")

if get_window_class() == "Chromium" then
  -- maximize() e idempotente (nao faz nada se ja maximizada) - nao
  -- depende de is_maximized(), que nao existe nesta versao do
  -- devilspie2 (erro "attempt to call global 'is_maximized' (a nil
  -- value)"), o que antes fazia o script inteiro abortar em erro.
  maximize()
else
  unmaximize()

  -- Posicionamento em cascata: as primeiras 4 janelas simultaneas ocupam
  -- posicoes fixas cortando a tela ao meio (1/2 lado a lado encostadas no
  -- topbar, 3/4 lado a lado 30% mais abaixo, espelhando 1/2); da 5a janela
  -- em diante, abre centralizada com um leve deslocamento a cada nova.
  local PANEL_HEIGHT = 26

  local function open_app_count()
    local handle = io.popen("wmctrl -lx 2>/dev/null | grep -viE 'plank|xfce4-panel|xfdesktop' | wc -l")
    if not handle then return 1 end
    local n = tonumber(handle:read("*a"))
    handle:close()
    return n or 1
  end

  local sw, sh = get_screen_geometry()
  if sw and sh and sw > 0 and sh > 0 then
    local ah = sh - PANEL_HEIGHT
    -- a propria janela que acabou de abrir ja entra nessa contagem, entao
    -- ela mesma vira o "slot" com esse numero
    local slot = open_app_count()

    local x, y, w, h

    if slot == 1 then
      x, y = 0.05 * sw, PANEL_HEIGHT
      w, h = 0.35 * sw, ah
    elseif slot == 2 then
      x, y = 0.60 * sw, PANEL_HEIGHT
      w, h = 0.35 * sw, ah
    elseif slot == 3 then
      x, y = 0.15 * sw, PANEL_HEIGHT + 0.30 * ah
      w, h = 0.45 * sw, 0.70 * ah
    elseif slot == 4 then
      x, y = 0.40 * sw, PANEL_HEIGHT + 0.30 * ah
      w, h = 0.45 * sw, 0.70 * ah
    else
      -- centralizada, com um passo de 30px em cascata por janela extra
      -- (volta ao inicio a cada 8 passos, pra nao ir saindo da tela)
      local step = ((slot - 5) % 8) * 30
      local _, _, cw, ch = get_window_geometry()
      w, h = cw, ch
      x = (sw / 2) - (w / 2) + step
      y = PANEL_HEIGHT + (ah / 2) - (h / 2) + step
    end

    set_window_geometry2(math.floor(x), math.floor(y), math.floor(w), math.floor(h))
  end
end
